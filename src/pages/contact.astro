---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Kontak — LaSALe FH UI">
  <Navbar />
  <main class="pt-20">
    <section class="py-24 md:py-32 bg-bg-dark">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-16">
          <p class="font-utility text-xs tracking-[0.3em] uppercase text-gold mb-4">Kontak</p>
          <h1 class="font-heading text-5xl md:text-6xl font-semibold text-pale-cream mb-4">
            Hubungi <span class="text-gradient-gold">Kami</span>
          </h1>
          <p class="font-body text-lg text-pale-cream/50 max-w-xl mx-auto">
            Hubungi kami untuk informasi lebih lanjut tentang LaSALe dan program-program kami.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
          <!-- Contact Info -->
          <div class="space-y-8">
            <div>
              <h3 class="font-heading text-xl font-semibold text-pale-cream mb-4">Alamat</h3>
              <p class="font-body text-pale-cream/60 leading-relaxed">
                Fakultas Hukum Universitas Indonesia<br />
                Kampus Baru UI, Depok<br />
                Jawa Barat 16424, Indonesia
              </p>
            </div>
            <div>
              <h3 class="font-heading text-xl font-semibold text-pale-cream mb-4">Email</h3>
              <a href="mailto:info@lasale.ac.id" class="font-body text-gold hover:text-gold-bright transition-colors">
                info@lasale.ac.id
              </a>
            </div>
            <div>
              <h3 class="font-heading text-xl font-semibold text-pale-cream mb-4">Media Sosial</h3>
              <div class="flex gap-4">
                <a href="https://www.instagram.com/lasalefhui/" target="_blank" rel="noopener" class="font-body text-pale-cream/60 hover:text-gold transition-colors">
                  Instagram
                </a>
                <a href="https://www.linkedin.com/company/lasale-fh-ui/" target="_blank" rel="noopener" class="font-body text-pale-cream/60 hover:text-gold transition-colors">
                  LinkedIn
                </a>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="border border-pale-cream/10 p-8">
            <h3 class="font-heading text-xl font-semibold text-pale-cream mb-6">Kirim Pesan</h3>
            <form class="space-y-4">
              <div>
                <label class="block font-utility text-xs text-pale-cream/50 uppercase tracking-wider mb-2">Nama</label>
                <input type="text" class="w-full bg-transparent border border-pale-cream/20 px-4 py-3 font-body text-sm text-pale-cream focus:border-gold focus:outline-none transition-colors" />
              </div>
              <div>
                <label class="block font-utility text-xs text-pale-cream/50 uppercase tracking-wider mb-2">Email</label>
                <input type="email" class="w-full bg-transparent border border-pale-cream/20 px-4 py-3 font-body text-sm text-pale-cream focus:border-gold focus:outline-none transition-colors" />
              </div>
              <div>
                <label class="block font-utility text-xs text-pale-cream/50 uppercase tracking-wider mb-2">Pesan</label>
                <textarea rows="4" class="w-full bg-transparent border border-pale-cream/20 px-4 py-3 font-body text-sm text-pale-cream focus:border-gold focus:outline-none transition-colors resize-none"></textarea>
              </div>
              <button type="submit" class="btn btn-primary w-full">
                Kirim Pesan
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
