---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const achievements = [
  { year: '2025', title: 'Juara 1 Lomba Moot Court Nasional', event: 'Kompetisi Peradilan Semu Nasional' },
  { year: '2024', title: 'Juara 2 Liga Hukum Nasional', event: 'National Law League' },
  { year: '2023', title: 'Best Memorandum Award', event: 'International Moot Court Competition' },
];
---

<Layout title="Achievements — LaSALe FH UI">
  <Navbar />
  <main class="pt-20">
    <section class="py-24 md:py-32 bg-bg-dark">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-16">
          <p class="font-utility text-xs tracking-[0.3em] uppercase text-gold mb-4">Prestasi</p>
          <h1 class="font-heading text-5xl md:text-6xl font-semibold text-pale-cream">
            <span class="text-gradient-gold">Achievements</span>
          </h1>
        </div>

        <div class="space-y-6">
          {achievements.map((a) => (
            <div class="border border-gold/30 p-8">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                  <div class="flex items-center gap-3 mb-2">
                    <h3 class="font-heading text-xl font-semibold text-pale-cream">{a.title}</h3>
                  </div>
                  <p class="font-body text-sm text-pale-cream/50 leading-relaxed">{a.event}</p>
                </div>
                <div class="shrink-0 text-right">
                  <p class="font-utility text-sm text-gold">{a.year}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
