---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tentang LaSALe — LaSALe FH UI">
  <Navbar />
  <main class="pt-20">
    <!-- Hero -->
    <section class="py-24 md:py-32 bg-bg-dark">
      <div class="max-w-4xl mx-auto px-6 lg:px-8 text-center">
        <p class="font-utility text-xs tracking-[0.3em] uppercase text-gold mb-4">Tentang</p>
        <h1 class="font-heading text-5xl md:text-6xl font-semibold text-pale-cream mb-6">
          Tentang <span class="text-gradient-gold">LaSALe</span>
        </h1>
        <p class="font-body text-lg text-pale-cream/60 max-w-2xl mx-auto leading-relaxed">
          Law Student Association for Legal Practice — wadah pengembangan kompetensi praktik hukum bagi mahasiswa Fakultas Hukum Universitas Indonesia.
        </p>
      </div>
    </section>

    <!-- Sejarah -->
    <section class="py-24 bg-primary-blue">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <h2 class="font-heading text-3xl font-semibold text-pale-cream mb-8">Sejarah</h2>
        <div class="space-y-4 font-body text-pale-cream/60 leading-relaxed">
          <p>
            LaSALe didirikan pada tahun 1987 sebagai bagian dari BEM Fakultas Hukum Universitas Indonesia. Sejak awal berdiri, organisasi ini berkomitmen untuk menjadi wadah pengembangan keterampilan praktis hukum bagi mahasiswa.
          </p>
          <p>
            Selama hampir empat dekade, LaSALe telah meluluskan ribuan alumni yang tersebar di berbagai sektor hukum, mulai dari litigasi, korporasi, akademisi, hingga advokasi hak asasi manusia.
          </p>
        </div>
      </div>
    </section>

    <!-- Visi Misi -->
    <section class="py-24 bg-bg-dark grid-bg">
      <div class="max-w-4xl mx-auto px-6 lg:px-8">
        <h2 class="font-heading text-3xl font-semibold text-pale-cream mb-8">Visi & Misi</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="border border-pale-cream/10 p-8">
            <h3 class="font-heading text-xl font-semibold text-gold mb-4">Visi</h3>
            <p class="font-body text-sm text-pale-cream/60 leading-relaxed">
              Menjadi organisasi mahasiswa hukum terdepan dalam mengembangkan kompetensi praktik hukum yang profesional dan berintegritas.
            </p>
          </div>
          <div class="border border-pale-cream/10 p-8">
            <h3 class="font-heading text-xl font-semibold text-gold mb-4">Misi</h3>
            <ul class="font-body text-sm text-pale-cream/60 leading-relaxed space-y-2">
              <li>• Menyelenggarakan program pengembangan keterampilan hukum</li>
              <li>• Memberikan layanan konsultasi hukum kepada masyarakat</li>
              <li>• Membangun jaringan profesional mahasiswa hukum</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
