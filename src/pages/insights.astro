---
import Layout from '../layouts/base.astro';
import Navigation from '../components/interactive/Navigation.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import ScrollReveal from '../components/interactive/ScrollReveal.astro';
import SoftStar from '../components/decorative/SoftStar.astro';
import PortalSparkle from '../components/decorative/PortalSparkle.astro';
import NewsletterFooter from '../sections/newsletter-footer.astro';
---

<Layout title="Insights — LaSALe">
  <Navigation />
  <main>
    <!-- Page hero -->
    <Section background="var(--color-primary)" tight>
      <SoftStar color="gold" size="350px" top="10%" right="4%" opacity="0.1" />
      <PortalSparkle top="24%" left="55%" size={18} opacity="0.7" />
      <Container>
        <div style={{ position: 'relative', zIndex: 'var(--z-content)', paddingTop: 'var(--space-32)', paddingBottom: 'var(--space-12)' }}>
          <ScrollReveal>
            <div class="section-label section-label--light" style={{ marginBottom: 'var(--space-6)' }}>
              Insights &amp; Analysis
            </div>
          </ScrollReveal>
          <div style={{ maxWidth: '600px' }}>
            <ScrollReveal delay={1}>
              <h1 style={{ fontSize: 'clamp(2.4rem, 5vw, 4rem)', lineHeight: '0.98', color: 'var(--color-warm-white)', marginBottom: 'var(--space-8)' }}>
                <span class="drop-cap drop-cap-light">T</span>he Member Archive
              </h1>
            </ScrollReveal>
            <ScrollReveal delay={2}>
              <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'clamp(0.95rem, 1.3vw, 1.12rem)', color: 'rgba(248,245,239,0.8)', lineHeight: 'var(--leading-normal)' }}>
                Brief bank, case index, statute library, advocacy lab recordings, and the annual report — available exclusively to LaSALe members in good standing.
              </p>
            </ScrollReveal>
          </div>
        </div>
      </Container>
    </Section>

    <!-- Resource grid -->
    <Section background="var(--color-bg)" gridBg>
      <Container>
        <div class="insights-grid-page" style="display: grid; gap: var(--space-6);">
          <!-- Featured resource -->
          <ScrollReveal>
            <div class="img-tint" style={{ border: '2px solid var(--color-primary)', gridColumn: '1 / -1' }}>
              <img src="https://picsum.photos/seed/lasale-archive-featured/1400/520" alt="" style={{ width: '100%', height: 'clamp(280px, 35vw, 440px)', objectFit: 'cover' }} class="duotone-img" />
              <div class="img-badge img-badge--gold">Featured · Volume XXXVII</div>
              <div style={{
                position: 'absolute',
                bottom: 0,
                left: 0,
                right: 0,
                padding: 'var(--space-6) var(--space-10)',
                zIndex: 1,
              }}>
                <div style={{ fontFamily: 'var(--font-heading)', fontWeight: 500, fontSize: '0.7rem', letterSpacing: '0.22em', textTransform: 'uppercase', color: 'var(--color-gold)', marginBottom: 'var(--space-2)' }}>Annual Report</div>
                <h3 style={{ fontSize: 'clamp(1.3rem, 2.5vw, 2rem)', color: 'var(--color-warm-white)', maxWidth: '600px' }}>The State of Legal Pedagogy — 2024 Findings</h3>
              </div>
            </div>
          </ScrollReveal>

          <!-- Grid items -->
          <ScrollReveal delay={0}>
            <article>
              <div class="img-tint" style={{ border: '2px solid var(--color-primary)', marginBottom: 'var(--space-4)' }}>
                <img src="https://picsum.photos/seed/lasale-res-brief/500/340" alt="" style={{ width: '100%', height: 'clamp(180px, 22vw, 280px)', objectFit: 'cover' }} class="duotone-img" />
                <div class="img-badge">Brief Bank</div>
              </div>
              <div style={{ fontFamily: 'var(--font-sans)', fontSize: '0.65rem', letterSpacing: '0.2em', textTransform: 'uppercase', color: 'var(--color-rose)', marginBottom: 'var(--space-1)' }}>142 Documents</div>
              <h3 style={{ fontSize: 'var(--text-xl)', marginBottom: 'var(--space-2)' }}>Appellate Brief Templates</h3>
              <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(24,24,24,0.65)', lineHeight: 'var(--leading-normal)' }}>A searchable collection of winning briefs from federal circuit and Supreme Court practice.</p>
            </article>
          </ScrollReveal>

          <ScrollReveal delay={1}>
            <article>
              <div class="img-tint" style={{ border: '2px solid var(--color-primary)', marginBottom: 'var(--space-4)' }}>
                <img src="https://picsum.photos/seed/lasale-res-cases/500/340" alt="" style={{ width: '100%', height: 'clamp(180px, 22vw, 280px)', objectFit: 'cover' }} class="duotone-img" />
                <div class="img-badge img-badge--gold">Case Library</div>
              </div>
              <div style={{ fontFamily: 'var(--font-sans)', fontSize: '0.65rem', letterSpacing: '0.2em', textTransform: 'uppercase', color: 'var(--color-rose)', marginBottom: 'var(--space-1)' }}>2,840 Cases</div>
              <h3 style={{ fontSize: 'var(--text-xl)', marginBottom: 'var(--space-2)' }}>Annotated Opinion Index</h3>
              <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(24,24,24,0.65)', lineHeight: 'var(--leading-normal)' }}>Every landmark opinion annotated by LaSALe faculty with practice-focused commentary.</p>
            </article>
          </ScrollReveal>

          <ScrollReveal delay={2}>
            <article>
              <div class="img-tint" style={{ border: '2px solid var(--color-primary)', marginBottom: 'var(--space-4)' }}>
                <img src="https://picsum.photos/seed/lasale-res-stat/500/340" alt="" style={{ width: '100%', height: 'clamp(180px, 22vw, 280px)', objectFit: 'cover' }} class="duotone-img" />
                <div class="img-badge">Statutes</div>
              </div>
              <div style={{ fontFamily: 'var(--font-sans)', fontSize: '0.65rem', letterSpacing: '0.2em', textTransform: 'uppercase', color: 'var(--color-rose)', marginBottom: 'var(--space-1)' }}>54 Jurisdictions</div>
              <h3 style={{ fontSize: 'var(--text-xl)', marginBottom: 'var(--space-2)' }}>Regulatory Cross-Reference</h3>
              <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(24,24,24,0.65)', lineHeight: 'var(--leading-normal)' }}>State and federal statutes cross-referenced with LaSALe practice guides.</p>
            </article>
          </ScrollReveal>

          <ScrollReveal delay={3}>
            <article>
              <div class="img-tint" style={{ border: '2px solid var(--color-primary)', marginBottom: 'var(--space-4)' }}>
                <img src="https://picsum.photos/seed/lasale-res-video/500/340" alt="" style={{ width: '100%', height: 'clamp(180px, 22vw, 280px)', objectFit: 'cover' }} class="duotone-img" />
                <div class="img-badge img-badge--gold">Recordings</div>
              </div>
              <div style={{ fontFamily: 'var(--font-sans)', fontSize: '0.65rem', letterSpacing: '0.2em', textTransform: 'uppercase', color: 'var(--color-rose)', marginBottom: 'var(--space-1)' }}>312 Hours</div>
              <h3 style={{ fontSize: 'var(--text-xl)', marginBottom: 'var(--space-2)' }}>Advocacy Lab Recordings</h3>
              <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(24,24,24,0.65)', lineHeight: 'var(--leading-normal)' }}>Full recordings of every Hartwell Institute lecture and workshop since 2019.</p>
            </article>
          </ScrollReveal>
        </div>
      </Container>
    </Section>
  </main>
  <NewsletterFooter />

  <script>
    import { initScrollReveals } from '../lib/observe';
    import { initPortalParallax } from '../lib/parallax';
    document.addEventListener('DOMContentLoaded', () => {
      initScrollReveals();
      initPortalParallax();
    });
  </script>
</Layout>

<style>
  .insights-grid-page {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .insights-grid-page {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .insights-grid-page {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
