---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const articles = [
  {
    title: 'Analisis Hukum: Regulasi Kecerdasan Buatan di Indonesia',
    category: 'Analysis',
    date: '2026-08-15',
    excerpt: 'Kajian mendalam tentang regulasi kecerdasan buatan yang sedang dikembangkan di Indonesia.',
  },
  {
    title: 'Opini: Pentingnya Literasi Hukum bagi Masyarakat',
    category: 'Opinion',
    date: '2026-08-10',
    excerpt: 'Perspektif tentang urgensi peningkatan literasi hukum di kalangan masyarakat luas.',
  },
  {
    title: 'Berita: LaSALe Gelar Simulasi Sidang Nasional',
    category: 'News',
    date: '2026-08-05',
    excerpt: 'Liputan tentang pelaksanaan simulasi sidang nasional yang diikuti oleh mahasiswa hukum dari berbagai universitas.',
  },
  {
    title: 'Analisis: Tantangan Penegakan Hukum Digital',
    category: 'Analysis',
    date: '2026-07-28',
    excerpt: 'Pemahaman tentang tantangan penegakan hukum di era digital dan transaksi elektronik.',
  },
  {
    title: 'Opini: Peran Advokat dalam Demokrasi',
    category: 'Opinion',
    date: '2026-07-20',
    excerpt: 'Refleksi tentang peran strategis advokat dalam menjaga demokrasi dan keadilan.',
  },
  {
    title: 'Berita: Workshop Penulisan Artikel Hukum',
    category: 'News',
    date: '2026-07-15',
    excerpt: 'Liputan workshop penulisan artikel hukum yang diselenggarakan oleh LaSALe.',
  },
];

const categoryColors: Record<string, string> = {
  News: 'bg-primary-blue',
  Opinion: 'bg-burgundy',
  Analysis: 'bg-gold text-bg-dark',
};
---

<Layout title="LaSALe Page — LaSALe FH UI">
  <Navbar />
  <main class="pt-20">
    <section class="py-24 md:py-32 bg-bg-dark">
      <div class="max-w-5xl mx-auto px-6 lg:px-8">
        <div class="text-center mb-16">
          <p class="font-utility text-xs tracking-[0.3em] uppercase text-gold mb-4">Artikel Hukum</p>
          <h1 class="font-heading text-5xl md:text-6xl font-semibold text-pale-cream mb-4">
            LaSALe <span class="text-gradient-gold">Page</span>
          </h1>
          <p class="font-body text-lg text-pale-cream/50 max-w-xl mx-auto">
            Artikel hukum yang ditulis oleh anggota LaSALe untuk dibagikan kepada masyarakat luas.
          </p>
        </div>

        <!-- Category Filter -->
        <div class="flex flex-wrap justify-center gap-3 mb-12">
          <button class="px-4 py-2 font-utility text-xs uppercase tracking-wider bg-gold text-bg-dark">Semua</button>
          <button class="px-4 py-2 font-utility text-xs uppercase tracking-wider border border-pale-cream/20 text-pale-cream/60 hover:border-gold hover:text-gold transition-colors">News</button>
          <button class="px-4 py-2 font-utility text-xs uppercase tracking-wider border border-pale-cream/20 text-pale-cream/60 hover:border-gold hover:text-gold transition-colors">Opinion</button>
          <button class="px-4 py-2 font-utility text-xs uppercase tracking-wider border border-pale-cream/20 text-pale-cream/60 hover:border-gold hover:text-gold transition-colors">Analysis</button>
        </div>

        <!-- Articles Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {articles.map((article) => (
            <article class="group border border-pale-cream/10 hover:border-gold/30 transition-colors duration-300">
              <div class="p-6 pb-0">
                <span class={`inline-block px-3 py-1 text-xs font-utility font-semibold uppercase tracking-wider ${categoryColors[article.category] || 'bg-primary-blue'} text-pale-cream`}>
                  {article.category}
                </span>
              </div>
              <div class="p-6">
                <h3 class="font-heading text-lg font-semibold text-pale-cream mb-3 group-hover:text-gold transition-colors leading-snug">
                  {article.title}
                </h3>
                <p class="font-body text-sm text-pale-cream/50 leading-relaxed mb-4">
                  {article.excerpt}
                </p>
                <div class="flex items-center justify-between">
                  <time class="font-utility text-xs text-pale-cream/30">
                    {new Date(article.date).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })}
                  </time>
                  <span class="font-utility text-xs text-gold group-hover:underline">Baca →</span>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
