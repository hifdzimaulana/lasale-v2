---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const SUPABASE_URL = import.meta.env.SUPABASE_URL || process.env.SUPABASE_URL;
const SUPABASE_KEY = import.meta.env.SUPABASE_SECRET_KEY || process.env.SUPABASE_SECRET_KEY;

const res = await fetch(`${SUPABASE_URL}/rest/v1/members?select=*&order=sort_order.asc`, {
  headers: {
    apikey: SUPABASE_KEY,
    Authorization: `Bearer ${SUPABASE_KEY}`,
  },
});
const raw = await res.json();
const allMembers: any[] = Array.isArray(raw) ? raw : [];

const pengurusInti = allMembers.filter((m: any) => m.category === 'pengurus_inti');
const bph = allMembers.filter((m: any) => m.category === 'bph');
const staff = allMembers.filter((m: any) => m.category === 'staff');

const bphByDiv: Record<string, any[]> = { kompetisi: [], internal: [], eksternal: [] };
bph.forEach((m: any) => { bphByDiv[m.division]?.push(m); });

const staffByDiv: Record<string, any[]> = { kompetisi: [], internal: [], eksternal: [] };
staff.forEach((m: any) => { staffByDiv[m.division]?.push(m); });

const FULL_TEAM_IMG = 'https://sqejhkhqqofigcnnmrjq.supabase.co/storage/v1/object/public/lasale-assets/fungsionaris/foto-fullteam.jpg';

const divisions = [
  { key: 'kompetisi', label: 'Kompetisi', accent: '#C0392B', accentRgba: '192,57,43' },
  { key: 'internal', label: 'Internal', accent: '#994B53', accentRgba: '153,75,83' },
  { key: 'eksternal', label: 'Eksternal', accent: '#5B8BD4', accentRgba: '91,139,212' },
];

function splitName(name: string) {
  return { first: name.charAt(0), rest: name.slice(1) };
}

function guilloche(startY: number, amplitude: number, waves: number, lineCount: number, width: number) {
  const paths: { d: string; opacity: number }[] = [];
  for (let l = 0; l < lineCount; l++) {
    const offset = l * 3;
    const amp = amplitude + l * 2;
    let d = '';
    for (let x = 0; x <= width; x += 6) {
      const y = startY + offset + Math.sin((x / width) * Math.PI * waves) * amp;
      d += (x === 0 ? 'M' : 'L') + `${x},${y.toFixed(1)}`;
    }
    paths.push({ d, opacity: 1 - (l / lineCount) * 0.5 });
  }
  return paths;
}

const meshTeam = guilloche(15, 40, 2, 24, 1440);
const meshPi = guilloche(5, 35, 2.5, 32, 1440);
const meshDivs = guilloche(10, 30, 2.2, 20, 1440);
---

<Layout title="Kepengurusan 2026" description="Struktur kepengurusan LaSALe FH UI periode 2026 — Organisasi Mahasiswa Fakultas Hukum Universitas Indonesia.">
  <Navbar />

  <!-- Hero -->
  <section class="relative bg-bg-dark pt-32 pb-16 lg:pt-40 lg:pb-20 overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-30"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 80%, rgba(28,59,135,0.25) 0%, transparent 60%)"></div>
    <div class="soft-star soft-star--yellow" style="width:320px;height:320px;top:5%;right:-8%;opacity:.10"></div>
    <div class="soft-star soft-star--burgundy" style="width:200px;height:200px;bottom:10%;left:5%;opacity:.12"></div>
    <div class="portal" style="top:20%;left:12%">
      <svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F6EB3D" opacity="0.8"/></svg>
    </div>
    <div class="portal" style="top:35%;right:15%">
      <svg width="10" height="10" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F7F2B7" opacity="0.6"/></svg>
    </div>
    <div class="portal" style="bottom:25%;left:30%">
      <svg width="8" height="8" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F6EB3D" opacity="0.5"/></svg>
    </div>
    <div class="relative max-w-[1400px] mx-auto px-6 lg:px-10 text-center">
      <p class="font-body text-[0.65rem] tracking-[0.3em] uppercase text-gold/70 mb-3 reveal">LaSALe FH UI 2026</p>
      <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-700 text-gradient-gold leading-[1.1] reveal">
        Kepengurusan<br/>2026
      </h1>
      <p class="font-body text-sm lg:text-base text-pale-cream/60 mt-4 max-w-xl mx-auto reveal">
        Susunan lengkap pengurus LaSALe FH UI periode 2026 — Organisasi Mahasiswa Fakultas Hukum Universitas Indonesia.
      </p>
    </div>
  </section>

  <!-- Full Team Photo -->
  <section class="relative bg-primary-blue overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-20"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 30% 50%, rgba(153,75,83,0.12) 0%, transparent 50%)"></div>
    <div class="soft-star soft-star--burgundy" style="width:250px;height:250px;top:20%;right:10%;opacity:.10"></div>
    <div class="portal" style="top:15%;left:8%">
      <svg width="12" height="12" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F6EB3D" opacity="0.7"/></svg>
    </div>
    <!-- Mesh: subtle, bottom-anchored, fading up -->
    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1440 300" preserveAspectRatio="none" style="opacity: 0.5;">
      <defs>
        <linearGradient id="ft-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="50%" stop-color="white" stop-opacity="0"/>
          <stop offset="100%" stop-color="white" stop-opacity="1"/>
        </linearGradient>
        <mask id="ft-mask"><rect width="1440" height="300" fill="url(#ft-fade)"/></mask>
      </defs>
      <g mask="url(#ft-mask)">
        {meshTeam.map((p) => (
          <path d={p.d} fill="none" stroke="rgba(250,246,235,0.06)" stroke-width="0.7" opacity={p.opacity}/>
        ))}
      </g>
    </svg>
    <div class="relative max-w-[1100px] mx-auto px-6 lg:px-10 py-12 lg:py-16">
      <div class="relative reveal">
        <div class="absolute -inset-[2px] bg-gradient-to-r from-gold/30 via-burgundy/20 to-gold/30 z-0"></div>
        <img
          src={FULL_TEAM_IMG}
          alt="LaSALe FH UI 2026 Full Team"
          class="relative w-full h-[320px] sm:h-[400px] lg:h-[480px] object-cover border border-pale-cream/10"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-primary-blue/60 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 px-3 py-1.5 bg-gold text-primary-blue font-display font-600 text-[0.6rem] tracking-[0.15em] uppercase">
          LaSALe FH UI · 2026
        </div>
      </div>
    </div>
  </section>

  <!-- Pengurus Inti -->
  <section class="relative bg-bg-dark overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-25"></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 60% 30%, rgba(246,235,61,0.06) 0%, transparent 50%)"></div>
    <div class="soft-star soft-star--yellow" style="width:300px;height:300px;top:15%;left:-5%;opacity:.08"></div>
    <div class="portal" style="top:10%;right:20%">
      <svg width="12" height="12" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F6EB3D" opacity="0.7"/></svg>
    </div>
    <div class="portal" style="bottom:15%;left:25%">
      <svg width="8" height="8" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F7F2B7" opacity="0.5"/></svg>
    </div>
    <!-- Mesh: full section background, top-heavy fade -->
    <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1440 300" preserveAspectRatio="none" style="opacity: 0.45;">
      <defs>
        <linearGradient id="pi-fade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="white" stop-opacity="0"/>
          <stop offset="15%" stop-color="white" stop-opacity="1"/>
          <stop offset="55%" stop-color="white" stop-opacity="1"/>
          <stop offset="70%" stop-color="white" stop-opacity="0"/>
        </linearGradient>
        <linearGradient id="pi-fade-h" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="white" stop-opacity="1"/>
          <stop offset="60%" stop-color="white" stop-opacity="0.6"/>
          <stop offset="100%" stop-color="white" stop-opacity="0"/>
        </linearGradient>
        <mask id="pi-mask">
          <rect width="1440" height="300" fill="url(#pi-fade)"/>
          <rect width="1440" height="300" fill="url(#pi-fade-h)"/>
        </mask>
      </defs>
      <g mask="url(#pi-mask)">
        {meshPi.map((p) => (
          <path d={p.d} fill="none" stroke="rgba(28,59,135,0.14)" stroke-width="0.7" opacity={p.opacity}/>
        ))}
      </g>
    </svg>
    <div class="relative max-w-[1200px] mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="reveal mb-12">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-[2px] bg-gold"></div>
          <p class="font-body text-[0.65rem] tracking-[0.3em] uppercase text-gold/70">01 · Struktur</p>
          <div class="flex-1 h-[1px] bg-gold/15"></div>
        </div>
        <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-700 text-gradient-gold mb-1">
          <span class="drop-cap drop-cap--gold" style="font-size: 1.8em;">P</span>engurus Inti
        </h2>
      </div>

      <div class="flex justify-center mb-8">
        <div class="reveal reveal-card w-full max-w-[280px]" style="--d:0s">
          <div class="group relative border border-pale-cream/10 bg-primary-blue/30 overflow-hidden transition-all duration-300 hover:border-gold/30">
            <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-transparent via-gold to-transparent opacity-40 group-hover:opacity-80 transition-opacity"></div>
            <div class="aspect-[3/4] overflow-hidden">
              <img src={pengurusInti[0].image_path} alt={pengurusInti[0].name} class="w-full h-full object-cover grayscale-[30%] transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0" loading="lazy" />
            </div>
            <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(16,32,74,1) 0%, rgba(16,32,74,0.6) 20%, transparent 40%)"></div>
            <div class="absolute bottom-0 left-0 right-0 p-4">
              <div class="w-8 h-[2px] bg-gold mb-2"></div>
              <h3 class="font-heading text-sm lg:text-base font-700 leading-tight" style="color: var(--color-accent-yellow)">{pengurusInti[0].name}</h3>
              <p class="font-body text-[0.65rem] text-pale-cream mt-1 leading-relaxed">{pengurusInti[0].role}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap justify-center gap-6 lg:gap-8">
        {pengurusInti.slice(1).map((m: any, i: number) => (
          <div class="reveal reveal-card w-[calc(50%-12px)] sm:w-[calc(33.333%-16px)] max-w-[280px]" style={`--d:${(i + 1) * 0.08}s`}>
            <div class="group relative border border-pale-cream/10 bg-primary-blue/30 overflow-hidden transition-all duration-300 hover:border-gold/30">
              <div class="absolute top-0 left-0 right-0 h-[3px] bg-gradient-to-r from-transparent via-gold to-transparent opacity-40 group-hover:opacity-80 transition-opacity"></div>
              <div class="aspect-[3/4] overflow-hidden">
                <img src={m.image_path} alt={m.name} class="w-full h-full object-cover grayscale-[30%] transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0" loading="lazy" />
              </div>
              <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(16,32,74,1) 0%, rgba(16,32,74,0.6) 20%, transparent 40%)"></div>
              <div class="absolute bottom-0 left-0 right-0 p-4">
                <div class="w-8 h-[2px] bg-gold mb-2"></div>
                <h3 class="font-heading text-sm lg:text-base font-700 leading-tight" style="color: var(--color-accent-yellow)">{m.name}</h3>
                <p class="font-body text-[0.65rem] text-pale-cream mt-1 leading-relaxed">{m.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Divisions -->
  {divisions.map((div, di) => {
    const divBph = bphByDiv[div.key] || [];
    const divStaff = staffByDiv[div.key] || [];
    const bgClass = div.key === 'kompetisi' ? 'bg-[#1a1a2e]' : di % 2 === 0 ? 'bg-primary-blue' : 'bg-bg-dark';
    return (
      <section class={`relative ${bgClass} overflow-hidden`}>
        <div class="absolute inset-0 grid-bg opacity-20"></div>
        {div.key === 'kompetisi' && (
          <div class="absolute inset-0" style={`background: radial-gradient(ellipse at 40% 20%, rgba(${div.accentRgba},0.12) 0%, transparent 50%), radial-gradient(ellipse at 70% 80%, rgba(${div.accentRgba},0.08) 0%, transparent 50%)`}></div>
        )}
        {div.key === 'internal' && (
          <div class="absolute inset-0" style={`background: radial-gradient(ellipse at 60% 40%, rgba(${div.accentRgba},0.10) 0%, transparent 50%)`}></div>
        )}
        {div.key === 'eksternal' && (
          <div class="absolute inset-0" style={`background: radial-gradient(ellipse at 30% 60%, rgba(${div.accentRgba},0.10) 0%, transparent 50%)`}></div>
        )}
        <div class={`soft-star soft-star--${div.key === 'kompetisi' ? 'burgundy' : div.key === 'internal' ? 'burgundy' : 'blue'}`} style={`width:200px;height:200px;top:10%;${di % 2 === 0 ? 'right:-5%' : 'left:-5%'};opacity:.08`}></div>
        <div class="portal" style={`top:12%;${di % 2 === 0 ? 'left:10%' : 'right:10%'}`}>
          <svg width="10" height="10" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F6EB3D" opacity="0.6"/></svg>
        </div>
        <!-- Mesh: full section background, bottom-heavy fade -->
        <svg class="absolute inset-0 w-full h-full" viewBox="0 0 1440 300" preserveAspectRatio="none" style="opacity: 0.35;">
          <defs>
            <linearGradient id={`dv-fade-${di}`} x1="0" y1="0" x2="0" y2="1">
              <stop offset="30%" stop-color="white" stop-opacity="0"/>
              <stop offset="60%" stop-color="white" stop-opacity="1"/>
              <stop offset="100%" stop-color="white" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id={`dv-fade-h-${di}`} x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="white" stop-opacity="0"/>
              <stop offset="40%" stop-color="white" stop-opacity="0.6"/>
              <stop offset="100%" stop-color="white" stop-opacity="1"/>
            </linearGradient>
            <mask id={`dv-mask-${di}`}>
              <rect width="1440" height="300" fill={`url(#dv-fade-${di})`}/>
              <rect width="1440" height="300" fill={`url(#dv-fade-h-${di})`}/>
            </mask>
          </defs>
          <g mask={`url(#dv-mask-${di})`}>
            {meshDivs.map((p) => (
              <path d={p.d} fill="none" stroke={`rgba(${div.accentRgba},0.10)`} stroke-width="0.7" opacity={p.opacity}/>
            ))}
          </g>
        </svg>
        <div class="relative max-w-[1200px] mx-auto px-6 lg:px-10 py-16 lg:py-20">
          <div class="reveal mb-10">
            <div class="flex items-center gap-3 mb-2">
              <div class="w-8 h-[2px]" style={`background: ${div.accent}`}></div>
              <p class="font-body text-[0.65rem] tracking-[0.3em] uppercase" style={`color: ${div.accent}cc`}>0{di + 2} · Divisi</p>
              <div class="flex-1 h-[1px]" style={`background: ${div.accent}22`}></div>
            </div>
            <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-700" style={`color: ${div.accent}`}>
              <span class="drop-cap" style={`color: ${div.accent}; font-size: 1.8em;`}>{splitName(div.label).first}</span>{splitName(div.label).rest}
            </h2>
            <div class="w-16 h-[2px] mt-3" style={`background: ${div.accent}44`}></div>
          </div>

          <div class="flex flex-wrap justify-center gap-5 mb-10">
            {divBph.map((m: any, i: number) => (
              <div class={`reveal reveal-card w-[calc(50%-10px)] sm:w-[calc(33.333%-14px)] lg:w-[calc(25%-15px)] max-w-[280px]`} style={`--d:${i * 0.08}s`}>
                <div class="group relative border border-pale-cream/10 bg-bg-dark/50 overflow-hidden transition-all duration-300 hover:border-gold/30">
                  <div class="absolute top-0 left-0 right-0 h-[3px] opacity-0 group-hover:opacity-100 transition-opacity" style={`background: linear-gradient(to right, transparent, ${div.accent}66, transparent);`}></div>
                  <div class="aspect-[3/4] overflow-hidden">
                    <img src={m.image_path} alt={m.name} class="w-full h-full object-cover grayscale-[30%] transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0" loading="lazy" />
                  </div>
                  <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(16,32,74,1) 0%, rgba(16,32,74,0.6) 20%, transparent 40%)"></div>
                  <div class="absolute bottom-0 left-0 right-0 p-3">
                    <div class="w-6 h-[2px] bg-gold mb-1.5"></div>
                    <h3 class="font-heading text-xs lg:text-sm font-700 leading-tight" style="color: var(--color-accent-yellow)">{m.name}</h3>
                    <p class="font-body text-[0.6rem] text-pale-cream mt-0.5">{m.role}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>

          {divStaff.length > 0 && (
            <div class="reveal">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-[1px]" style={`background: ${div.accent}44`}></div>
                <p class="font-body text-[0.6rem] tracking-[0.2em] uppercase text-pale-cream/40">Staff Divisi {div.label}</p>
                <div class="flex-1 h-[1px]" style={`background: ${div.accent}22`}></div>
                <span class="font-body text-[0.6rem] text-pale-cream/30">{divStaff.length} orang</span>
              </div>
              <div class="flex flex-wrap justify-center gap-4">
                {divStaff.map((m: any, i: number) => (
                  <div class="reveal reveal-card w-[calc(50%-8px)] sm:w-[calc(33.333%-11px)] lg:w-[calc(20%-13px)] max-w-[220px]" style={`--d:${i * 0.04}s`}>
                    <div class="group relative border border-pale-cream/10 bg-bg-dark/30 overflow-hidden transition-all duration-300 hover:border-gold/30">
                      <div class="absolute top-0 left-0 right-0 h-[2px] opacity-0 group-hover:opacity-100 transition-opacity" style={`background: linear-gradient(to right, transparent, ${div.accent}44, transparent);`}></div>
                      <div class="aspect-[3/4] overflow-hidden">
                        <img src={m.image_path} alt={m.name} class="w-full h-full object-cover grayscale-[30%] transition-all duration-500 group-hover:scale-105 group-hover:grayscale-0" loading="lazy" />
                      </div>
                      <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(16,32,74,1) 0%, rgba(16,32,74,0.6) 20%, transparent 40%)"></div>
                      <div class="absolute bottom-0 left-0 right-0 p-3">
                        <h3 class="font-heading text-xs font-600 leading-tight" style="color: var(--color-accent-yellow)">{m.name}</h3>
                        <p class="font-body text-[0.55rem] text-pale-cream/70 mt-0.5">Staff</p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    );
  })}

  <Footer />
</Layout>

<style>
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-card { transition-delay: var(--d, 0s); }
</style>

<script>
  function initReveal() {
    const els = document.querySelectorAll('.reveal');
    if (!els.length) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); io.unobserve(e.target); } });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    els.forEach((el) => io.observe(el));
  }
  initReveal();
  document.addEventListener('astro:page-load', initReveal);
</script>
