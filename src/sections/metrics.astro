---
import Container from '../components/layout/Container.astro';
import Stat from '../components/typography/Stat.astro';
import ScrollReveal from '../components/interactive/ScrollReveal.astro';
import Section from '../components/layout/Section.astro';
---

<Section background="var(--color-bg)" gridBg>
  <Container>
    <!-- Header -->
    <div
      class="metrics-header"
      style={{
        display: 'grid',
        gap: 'var(--space-8)',
        marginBottom: 'var(--space-12)',
      }}
    >
      <div>
        <ScrollReveal>
          <div class="section-label" style={{ marginBottom: 'var(--space-6)' }}>
            Section III · By the Numbers
          </div>
        </ScrollReveal>
        <ScrollReveal delay={1}>
          <h2 style={{ fontSize: 'clamp(2rem, 4vw, 2.8rem)', lineHeight: '1.04' }}>
            <span class="drop-cap">A</span> Record of <br />Measurable Impact
          </h2>
        </ScrollReveal>
      </div>
      <ScrollReveal delay={2}>
        <p
          style={{
            fontFamily: 'var(--font-sans)',
            fontSize: 'var(--text-base)',
            color: 'rgba(24, 24, 24, 0.7)',
            lineHeight: 'var(--leading-normal)',
            display: 'flex',
            alignItems: 'flex-end',
          }}
        >
          Every figure below is audited annually by the LaSALe Board of Regents and published in our Spring Convocation Bulletin.
        </p>
      </ScrollReveal>
    </div>

    <!-- Stat rows -->
    <ScrollReveal>
      <div style={{ border: '2px solid var(--color-primary)' }}>
        <Stat
          number="14,800"
          suffix="+"
          label="Active Membership"
          description="Students enrolled across 142 accredited law schools, with chapter presence in 47 states and the District of Columbia."
        />
        <Stat
          number="312"
          suffix=""
          label="Partner Institutions"
          description="Law firms, federal and state courts, public-interest organizations, and regulatory agencies hosting LaSALe externs annually."
        />
        <Stat
          number="94"
          suffix="%"
          label="Placement Velocity"
          description="Of certified members secure federal clerkships or full-time associate positions within ninety days of bar admission."
        />
        <Stat
          number="$2.4"
          suffix="M"
          label="Fellowship Funding"
          description="Awarded annually in named fellowships supporting public-interest placements, judicial externships, and policy research."
        />
      </div>
    </ScrollReveal>
  </Container>
</Section>

<style>
  @media (min-width: 768px) {
    .metrics-header {
      grid-template-columns: 5fr 3fr;
    }
  }
</style>
