---
import Container from '../components/layout/Container.astro';
import ScrollReveal from '../components/interactive/ScrollReveal.astro';
import SoftStar from '../components/decorative/SoftStar.astro';
---

<section
  style={{
    position: 'relative',
    background: 'var(--color-primary)',
    overflow: 'hidden',
    paddingTop: 'var(--space-16)',
    paddingBottom: 'var(--space-16)',
    borderTop: '2px solid rgba(255, 243, 74, 0.3)',
    borderBottom: '2px solid rgba(255, 243, 74, 0.3)',
  }}
>
  <SoftStar color="gold" size="300px" top="50%" left="30%" opacity="0.07" />

  <Container>
    <div style={{ position: 'relative', zIndex: 'var(--z-content)' }}>
      <div
        class="partners-header"
        style={{
          display: 'flex',
          flexWrap: 'wrap',
          alignItems: 'flex-end',
          justifyContent: 'space-between',
          gap: 'var(--space-4)',
          marginBottom: 'var(--space-10)',
        }}
      >
        <div>
          <ScrollReveal>
            <div class="section-label section-label--light" style={{ marginBottom: 'var(--space-3)' }}>
              Section V · Institutional Partners
            </div>
          </ScrollReveal>
          <ScrollReveal delay={1}>
            <h3 style={{ fontSize: 'clamp(1.4rem, 3vw, 2rem)', color: 'var(--color-warm-white)' }}>
              Affiliated Firms &amp; Courts
            </h3>
          </ScrollReveal>
        </div>
        <ScrollReveal delay={2}>
          <p style={{
            fontFamily: 'var(--font-sans)',
            fontSize: 'var(--text-sm)',
            color: 'rgba(248,245,239,0.6)',
            maxWidth: '400px',
            lineHeight: 'var(--leading-normal)',
          }}>
            LaSALe is sustained by 312 partner organizations who fund programming, host externships, and recruit directly from our membership.
          </p>
        </ScrollReveal>
      </div>
    </div>
  </Container>

  <!-- Marquee -->
  <div style={{ overflow: 'hidden', position: 'relative' }}>
    <div style={{ position: 'absolute', left: 0, top: 0, bottom: 0, width: '8rem', background: 'linear-gradient(90deg, var(--color-primary), transparent)', zIndex: 10, pointerEvents: 'none' }}></div>
    <div style={{ position: 'absolute', right: 0, top: 0, bottom: 0, width: '8rem', background: 'linear-gradient(270deg, var(--color-primary), transparent)', zIndex: 10, pointerEvents: 'none' }}></div>

    <div class="marquee-anim" style={{ padding: 'var(--space-6) 0' }}>
      <!-- Set 1 -->
      <div class="marquee-track" style={{ display: 'flex', alignItems: 'center', gap: '5rem', padding: '0 2.5rem', float: 'left' }}>
        <span class="marquee-item">Hartwell &amp; Vance</span>
        <span class="marquee-item italic">Carrington LLP</span>
        <span class="marquee-item tracking-wide">PRESCOTT</span>
        <span class="marquee-item gold">Whitfield Cooperative</span>
        <span class="marquee-item">Morrow Abbey</span>
        <span class="marquee-item italic">Sutherland &amp; Kohl</span>
        <span class="marquee-item tracking-wide">RENNICK</span>
        <span class="marquee-item gold">Federal Circuit Bar</span>
      </div>
      <!-- Set 2 (duplicate for seamless) -->
      <div class="marquee-track" style={{ display: 'flex', alignItems: 'center', gap: '5rem', padding: '0 2.5rem', float: 'left' }}>
        <span class="marquee-item">Hartwell &amp; Vance</span>
        <span class="marquee-item italic">Carrington LLP</span>
        <span class="marquee-item tracking-wide">PRESCOTT</span>
        <span class="marquee-item gold">Whitfield Cooperative</span>
        <span class="marquee-item">Morrow Abbey</span>
        <span class="marquee-item italic">Sutherland &amp; Kohl</span>
        <span class="marquee-item tracking-wide">RENNICK</span>
        <span class="marquee-item gold">Federal Circuit Bar</span>
      </div>
    </div>
  </div>

  <Container>
    <div style={{ marginTop: 'var(--space-10)', display: 'flex', flexWrap: 'wrap', alignItems: 'center', justifyContent: 'space-between', gap: 'var(--space-4)' }}>
      <ScrollReveal>
        <a href="/about" class="link-arrow" style="color: var(--color-gold); border-bottom-color: var(--color-gold);">View All 312 Partners →</a>
      </ScrollReveal>
      <ScrollReveal delay={1}>
        <span style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-xs)', letterSpacing: 'var(--tracking-wider)', textTransform: 'uppercase', color: 'rgba(248,245,239,0.45)' }}>Partner Bar · Affiliated 1987 – Present</span>
      </ScrollReveal>
    </div>
  </Container>
</section>

<style>
  .marquee-item {
    font-family: var(--font-heading);
    font-weight: 700;
    color: rgba(248, 245, 239, 0.7);
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .marquee-item.italic {
    font-weight: 600;
    font-style: italic;
    font-size: 1.25rem;
  }

  .marquee-item.tracking-wide {
    letter-spacing: 0.15em;
  }

  .marquee-item.gold {
    color: rgba(255, 243, 74, 0.8);
    font-weight: 600;
    font-size: 1.25rem;
  }
</style>
