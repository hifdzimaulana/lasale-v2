---
import Container from '../components/layout/Container.astro';
import ScrollReveal from '../components/interactive/ScrollReveal.astro';
import SoftStar from '../components/decorative/SoftStar.astro';
import PortalSparkle from '../components/decorative/PortalSparkle.astro';
import WaveDivider from '../components/decorative/WaveDivider.astro';
---

<section
  style={{
    position: 'relative',
    background: 'var(--color-primary)',
    color: 'var(--color-warm-white)',
    overflow: 'hidden',
    paddingTop: 'var(--section-py)',
    paddingBottom: 'var(--section-py)',
  }}
>
  <SoftStar color="gold" size="440px" top="8%" right="-4%" opacity="0.11" />
  <SoftStar color="rose" size="300px" bottom="4%" left="28%" opacity="0.16" />
  <PortalSparkle top="16%" left="6%" size={18} opacity="0.85" />
  <PortalSparkle bottom="22%" right="40%" size={12} color="#F8F4A6" opacity="0.6" />

  <Container>
    <div style={{ position: 'relative', zIndex: 'var(--z-content)' }}>
      <!-- Section label -->
      <div class="section-label section-label--light reveal" style={{ marginBottom: 'var(--space-8)' }}>
        Section I · The Institute
      </div>

      <!-- Two-column layout -->
      <div
        class="mission-grid"
        style={{
          display: 'grid',
          gap: 'var(--space-12)',
          alignItems: 'start',
        }}
      >
        <!-- Text column -->
        <div>
          <ScrollReveal>
            <h2
              style={{
                fontSize: 'clamp(2rem, 5vw, 3.2rem)',
                lineHeight: '1.02',
                marginBottom: 'var(--space-8)',
                color: 'var(--color-warm-white)',
              }}
            >
              <span class="drop-cap drop-cap-light">A</span> Scholarly Foundation <br />for the Practicing Bar
            </h2>
          </ScrollReveal>

          <ScrollReveal delay={1}>
            <p
              style={{
                fontFamily: 'var(--font-sans)',
                fontSize: 'clamp(0.95rem, 1.2vw, 1.05rem)',
                color: 'rgba(248, 245, 239, 0.8)',
                lineHeight: 'var(--leading-normal)',
                marginBottom: 'var(--space-6)',
              }}
            >
              For thirty-seven years, LaSALe has served as the connective tissue between legal education and the practicing bar. Our curriculum is co-authored by sitting judges, tenured faculty, and senior partners — ensuring every program translates doctrine into craft.
            </p>
            <p
              style={{
                fontFamily: 'var(--font-sans)',
                fontSize: 'var(--text-base)',
                color: 'rgba(248, 245, 239, 0.65)',
                lineHeight: 'var(--leading-normal)',
                marginBottom: 'var(--space-10)',
              }}
            >
              Members access a continuous cycle of workshops, amicus participation, and supervised casework — culminating in our annual Certificate of Advanced Practice, recognized by 312 partner firms and 47 jurisdictions.
            </p>
          </ScrollReveal>

          <ScrollReveal delay={2}>
            <div style={{ display: 'flex', flexWrap: 'wrap', gap: 'var(--space-4)' }}>
              <a
                href="/about"
                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: '0.7rem',
                  padding: '1rem 1.9rem',
                  background: 'var(--color-rose)',
                  color: '#fff',
                  fontFamily: 'var(--font-heading)',
                  fontWeight: 600,
                  fontSize: 'var(--text-xs)',
                  letterSpacing: 'var(--tracking-wide)',
                  textTransform: 'uppercase',
                  border: 'none',
                  cursor: 'pointer',
                  textDecoration: 'none',
                  transition: 'transform .35s, box-shadow .35s',
                }}
                class="btn-rose"
              >
                Read the Prospectus
              </a>
              <a
                href="/about"
                style={{
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: '0.5rem',
                  fontFamily: 'var(--font-heading)',
                  fontWeight: 600,
                  fontSize: 'var(--text-xs)',
                  letterSpacing: 'var(--tracking-wide)',
                  textTransform: 'uppercase',
                  color: 'var(--color-warm-white)',
                  borderBottom: '2px solid var(--color-gold)',
                  paddingBottom: '0.25rem',
                  textDecoration: 'none',
                  transition: 'gap .25s var(--ease-out-expo)',
                }}
                class="btn-text"
              >
                Faculty Roster <span>→</span>
              </a>
            </div>
          </ScrollReveal>
        </div>

        <!-- Image column -->
        <div
          class="mission-image-col"
          style={{ position: 'relative' }}
        >
          <ScrollReveal delay={1}>
            <!-- Decorative accent blocks -->
            <div
              style={{
                position: 'absolute',
                left: '-1rem',
                top: '-1rem',
                width: '6rem',
                height: '6rem',
                background: 'var(--color-gold)',
                zIndex: 0,
                display: 'none',
              }}
              class="lg-block"
            ></div>
            <div
              style={{
                position: 'absolute',
                right: '-0.75rem',
                bottom: '-0.75rem',
                width: '8rem',
                height: '8rem',
                border: '2px solid var(--color-gold)',
                zIndex: 0,
                display: 'none',
              }}
              class="lg-block"
            ></div>

            <!-- Main image -->
            <div
              class="img-tint img-tint--heavy"
              style={{
                position: 'relative',
                border: '2px solid rgba(255, 243, 74, 0.4)',
                zIndex: 1,
              }}
            >
              <img
                src="https://picsum.photos/seed/lasale-courtroom/1100/720"
                alt=""
                style={{ width: '100%', height: 'clamp(300px, 50vw, 580px)', objectFit: 'cover' }}
                class="duotone-img"
              />
              <div class="img-badge img-badge--gold">Hartwell Institute · Est. 1987</div>
            </div>

            <!-- Floating caption block -->
            <div
              style={{
                position: 'absolute',
                bottom: '-2rem',
                left: '1.5rem',
                background: 'var(--color-bg)',
                padding: 'var(--space-5)',
                maxWidth: '300px',
                zIndex: 2,
                border: '2px solid var(--color-primary)',
              }}
              class="floating-caption"
            >
              <div style={{ fontFamily: 'var(--font-display)', color: 'var(--color-rose)', fontSize: '1.5rem', lineHeight: 1, marginBottom: '0.25rem' }}>No.</div>
              <div style={{ fontFamily: 'var(--font-heading)', fontWeight: 700, color: 'var(--color-primary)', fontSize: '1.8rem', lineHeight: 1, marginBottom: 'var(--space-3)' }}>XII</div>
              <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(24,24,24,0.7)', lineHeight: 'var(--leading-snug)' }}>
                The Hartwell Institute convenes twelve times annually for advanced advocacy workshops.
              </p>
            </div>
          </ScrollReveal>
        </div>
      </div>
    </div>
  </Container>

  <WaveDivider fill="var(--color-bg)" />
</section>

<style>
  @media (min-width: 1024px) {
    .mission-grid {
      grid-template-columns: 5fr 7fr;
      gap: var(--space-20) !important;
    }

    .mission-image-col .lg-block {
      display: block !important;
    }

    .mission-image-col {
      position: sticky;
      top: var(--space-10);
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .mission-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .btn-rose:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -18px rgba(177, 94, 103, 0.6);
  }

  .btn-text:hover {
    gap: 0.75rem;
  }

  .floating-caption {
    display: none;
  }

  @media (min-width: 768px) {
    .floating-caption {
      display: block;
    }
  }
</style>
