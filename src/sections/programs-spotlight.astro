---
import Container from '../components/layout/Container.astro';
import ScrollReveal from '../components/interactive/ScrollReveal.astro';
import SoftStar from '../components/decorative/SoftStar.astro';
import PortalSparkle from '../components/decorative/PortalSparkle.astro';
import WaveDivider from '../components/decorative/WaveDivider.astro';
---

<section
  style={{
    position: 'relative',
    background: 'var(--color-primary)',
    color: 'var(--color-warm-white)',
    overflow: 'hidden',
    paddingTop: 'var(--section-py)',
    paddingBottom: 'var(--section-py)',
  }}
>
  <SoftStar color="gold" size="400px" top="4%" right="2%" opacity="0.12" />
  <SoftStar color="rose" size="300px" bottom="8%" left="4%" opacity="0.16" />
  <PortalSparkle top="16%" right="28%" size={20} opacity="0.85" />
  <PortalSparkle bottom="28%" left="18%" size={14} color="#F8F4A6" opacity="0.6" />

  <Container>
    <div style={{ position: 'relative', zIndex: 'var(--z-content)' }}>
      <!-- Header -->
      <div
        class="spotlight-header"
        style={{
          display: 'grid',
          gap: 'var(--space-8)',
          marginBottom: 'var(--space-16)',
        }}
      >
          <div>
          <ScrollReveal>
            <div class="section-label section-label--light" style={{ marginBottom: 'var(--space-6)' }}>
              Section IV · Program Spotlight
            </div>
          </ScrollReveal>
          <ScrollReveal delay={1}>
            <h2
              style={{
                fontSize: 'clamp(2.2rem, 5vw, 3.2rem)',
                lineHeight: '1.02',
                color: 'var(--color-warm-white)',
              }}
            >
              <span class="drop-cap drop-cap-light">F</span>lagship Initiatives
            </h2>
          </ScrollReveal>
        </div>
        <ScrollReveal delay={2}>
          <p
            style={{
              fontFamily: 'var(--font-sans)',
              fontSize: 'var(--text-base)',
              color: 'rgba(248, 245, 239, 0.7)',
              lineHeight: 'var(--leading-normal)',
              maxWidth: '520px',
              display: 'flex',
              alignItems: 'flex-end',
            }}
          >
            Three flagship initiatives run in parallel throughout the academic year — each designed to layer doctrine, drafting, and deposition into a single arc of professional formation.
          </p>
        </ScrollReveal>
      </div>

      <!-- Staggered blocks -->
      <div class="staggered-container">
        <!-- Block 1 -->
        <ScrollReveal as="article" delay={0}>
          <div
            class="stagger-block"
            style={{
              background: 'var(--color-bg)',
              color: 'var(--color-near-black)',
              padding: 'var(--space-10)',
              position: 'relative',
            }}
          >
            <div
              style={{
                position: 'absolute',
                top: 0,
                left: 0,
                right: 0,
                height: '4px',
                background: 'linear-gradient(90deg, var(--color-primary), var(--color-rose))',
              }}
            ></div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--space-3)', marginBottom: 'var(--space-6)' }}>
              <span style={{ fontFamily: 'var(--font-heading)', fontWeight: 700, color: 'var(--color-rose)', fontSize: '1.5rem' }}>I.</span>
              <span style={{ fontFamily: 'var(--font-heading)', fontWeight: 500, fontSize: 'var(--text-xs)', letterSpacing: 'var(--tracking-wider)', textTransform: 'uppercase', color: 'var(--color-rose)' }}>The Hartwell Institute</span>
            </div>
            <h3 style={{ fontSize: '1.5rem', marginBottom: 'var(--space-4)' }}>Advanced Appellate Advocacy</h3>
            <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(24,24,24,0.7)', lineHeight: 'var(--leading-normal)', marginBottom: 'var(--space-6)' }}>
              A twelve-week intensive in federal appellate practice, co-taught by sitting circuit judges and former Supreme Court clerks. Members draft live briefs on cert-stage questions.
            </p>
            <div class="img-tint" style={{ border: '2px solid var(--color-primary)', marginBottom: 'var(--space-6)' }}>
              <img src="https://picsum.photos/seed/lasale-stagger1/600/360" alt="" style={{ width: '100%', height: '200px', objectFit: 'cover' }} class="duotone-img" />
            </div>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingTop: 'var(--space-4)', borderTop: '1px solid rgba(40,62,156,0.15)' }}>
              <span style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-xs)', color: 'rgba(24,24,24,0.6)' }}>12 weeks · 24 seats · Federal CLE</span>
              <a href="/programs" class="link-arrow">Apply →</a>
            </div>
          </div>
        </ScrollReveal>

        <!-- Block 2 -->
        <ScrollReveal as="article" delay={1}>
          <div
            class="stagger-block"
            style={{
              background: 'var(--color-gold)',
              color: 'var(--color-primary)',
              padding: 'var(--space-10)',
              position: 'relative',
            }}
          >
            <div
              style={{
                position: 'absolute',
                top: 0,
                left: 0,
                right: 0,
                height: '4px',
                background: 'var(--color-primary)',
              }}
            ></div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--space-3)', marginBottom: 'var(--space-6)' }}>
              <span style={{ fontFamily: 'var(--font-heading)', fontWeight: 700, color: 'var(--color-rose)', fontSize: '1.5rem' }}>II.</span>
              <span style={{ fontFamily: 'var(--font-heading)', fontWeight: 500, fontSize: 'var(--text-xs)', letterSpacing: 'var(--tracking-wider)', textTransform: 'uppercase', color: 'var(--color-rose)' }}>Drafting Lab</span>
            </div>
            <h3 style={{ fontSize: '1.5rem', marginBottom: 'var(--space-4)', color: 'var(--color-primary)' }}>Transactional Drafting Studio</h3>
            <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(40,62,156,0.75)', lineHeight: 'var(--leading-normal)', marginBottom: 'var(--space-6)' }}>
              Weekly studios in M&amp;A, securities, and commercial leasing. Members redline live deal documents under senior partner review.
            </p>
            <div style={{ border: '2px solid var(--color-primary)', marginBottom: 'var(--space-6)', padding: 'var(--space-4)', background: 'var(--color-bg)' }}>
              <div style={{ fontFamily: 'var(--font-display)', color: 'var(--color-rose)', fontSize: '1.5rem', lineHeight: 1, marginBottom: '0.25rem' }}>No.</div>
              <div style={{ fontFamily: 'var(--font-heading)', fontWeight: 700, color: 'var(--color-primary)', fontSize: '1.8rem', lineHeight: 1 }}>48</div>
              <div style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-xs)', color: 'rgba(24,24,24,0.6)', marginTop: '0.25rem' }}>Studio sessions / year</div>
            </div>
            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingTop: 'var(--space-4)', borderTop: '1px solid rgba(40,62,156,0.25)' }}>
              <span style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-xs)', color: 'rgba(40,62,156,0.7)' }}>Ongoing · Open enrollment</span>
              <a href="/programs" class="link-arrow">Enroll →</a>
            </div>
          </div>
        </ScrollReveal>

        <!-- Block 3 -->
        <ScrollReveal as="article" delay={2}>
          <div
            class="stagger-block"
            style={{
              background: 'var(--color-rose)',
              color: 'var(--color-warm-white)',
              padding: 'var(--space-8)',
              position: 'relative',
            }}
          >
            <div
              style={{
                position: 'absolute',
                top: 0,
                left: 0,
                right: 0,
                height: '4px',
                background: 'var(--color-gold)',
              }}
            ></div>
            <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--space-3)', marginBottom: 'var(--space-6)' }}>
              <span style={{ fontFamily: 'var(--font-heading)', fontWeight: 700, color: 'var(--color-gold)', fontSize: '1.5rem' }}>III.</span>
            </div>
            <h3 style={{ fontSize: '1.3rem', marginBottom: 'var(--space-4)', color: 'var(--color-warm-white)' }}>Judicial Shadowing</h3>
            <p style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-sm)', color: 'rgba(248,245,239,0.75)', lineHeight: 'var(--leading-normal)', marginBottom: 'var(--space-6)' }}>
              Two-week bench externships across federal district and circuit courts.
            </p>
            <div style={{ fontFamily: 'var(--font-heading)', fontWeight: 700, color: 'var(--color-gold)', fontSize: 'clamp(2rem, 4vw, 2.8rem)', lineHeight: 1, marginBottom: 'var(--space-1)' }}>312</div>
            <div style={{ fontFamily: 'var(--font-sans)', fontSize: 'var(--text-xs)', letterSpacing: '0.2em', textTransform: 'uppercase', color: 'rgba(248,245,239,0.7)', marginBottom: 'var(--space-6)' }}>Partner Courts</div>
            <a href="/programs" class="link-arrow" style="color: var(--color-gold); border-bottom-color: var(--color-gold);">Apply →</a>
          </div>
        </ScrollReveal>
      </div>
    </div>
  </Container>

  <WaveDivider fill="var(--color-bg)" />
</section>

<style>
  @media (min-width: 768px) {
    .spotlight-header {
      grid-template-columns: 7fr 4fr;
    }
  }

  .staggered-container {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .staggered-container {
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-0);
    }

    .staggered-container > :nth-child(1) {
      grid-column: 1 / 6;
    }

    .staggered-container > :nth-child(2) {
      grid-column: 5 / 10;
      margin-top: 5rem;
    }

    .staggered-container > :nth-child(3) {
      grid-column: 9 / 13;
      margin-top: 11rem;
    }
  }
</style>
