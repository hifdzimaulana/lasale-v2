---
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

const slides = [
  { src: 'https://picsum.photos/seed/lasale-hero1/1600/900.jpg', alt: 'LaSALe Kegiatan 1' },
  { src: 'https://picsum.photos/seed/lasale-hero2/1600/900.jpg', alt: 'LaSALe Kegiatan 2' },
  { src: 'https://picsum.photos/seed/lasale-hero3/1600/900.jpg', alt: 'LaSALe Kegiatan 3' },
  { src: 'https://picsum.photos/seed/lasale-hero4/1600/900.jpg', alt: 'LaSALe Kegiatan 4' },
  { src: 'https://picsum.photos/seed/lasale-hero5/1600/900.jpg', alt: 'LaSALe Kegiatan 5' },
];
---

<section class="hero-swiper-section relative bg-[var(--color-primary-blue)]">
  <div class="swiper hero-swiper">
    <div class="swiper-wrapper">
      {slides.map((s, i) => (
        <div class="swiper-slide">
          <div class="hero-slide">
            <img src={s.src} alt={s.alt} class="hero-slide__img" />
            <div class="hero-slide__overlay"></div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Content overlay -->
  <div class="hero-content">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 h-full flex items-center">
      <div class="grid lg:grid-cols-12 gap-12 items-center w-full">
        <div class="lg:col-span-6">
          <div class="flex items-center gap-3 mb-7">
            <div class="w-8 h-[2px] bg-[var(--color-accent-yellow)]"></div>
            <span class="font-display font-500 text-[0.7rem] tracking-[0.28em] uppercase text-[var(--color-accent-yellow)]">Est. 1987 · Fakultas Hukum UI</span>
          </div>
          <h1 class="text-[3rem] sm:text-[4rem] lg:text-[5.5rem] leading-[0.94] mb-7 text-[var(--color-bg-offwhite)]">
            Membangun<br />
            Bakat Hukum<br />
            <span class="text-[var(--color-accent-yellow)]">Masa Depan</span>
          </h1>
          <p class="font-body text-[1.1rem] lg:text-[1.2rem] text-[var(--color-bg-offwhite)]/80 leading-relaxed mb-10 max-w-[520px]">
            Law Student Association for Legal Practice — wadah pengembangan kompetensi praktis hukum bagi mahasiswa Fakultas Hukum Universitas Indonesia.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="/about" class="btn-primary">Jelajahi Program <span>→</span></a>
            <a href="/about" class="btn-outline border-[var(--color-bg-offwhite)] text-[var(--color-bg-offwhite)] hover:bg-[var(--color-bg-offwhite)] hover:text-[var(--color-primary-blue)]">Tentang LaSALe</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Corner mark -->
  <div class="hero-corner">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <div class="flex items-center gap-3">
        <div class="w-10 h-[1px] bg-[var(--color-bg-offwhite)]/30"></div>
        <span class="font-body text-[0.65rem] tracking-[0.3em] uppercase text-[var(--color-bg-offwhite)]/40">No. XXXVII</span>
      </div>
    </div>
  </div>

  <!-- Nav arrows -->
  <div class="hero-nav">
    <button class="hero-nav__btn hero-nav__prev" aria-label="Previous">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="hero-nav__counter">
      <span class="hero-nav__current">01</span>
      <span class="hero-nav__sep">/</span>
      <span class="hero-nav__total">0{slides.length}</span>
    </div>
    <button class="hero-nav__btn hero-nav__next" aria-label="Next">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { Navigation, Autoplay, EffectFade } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/navigation';
  import 'swiper/css/effect-fade';

  function initHeroSwiper() {
    const el = document.querySelector('.hero-swiper');
    if (!el || el.dataset.swiperInit === '1') return;
    el.dataset.swiperInit = '1';

    const counter = document.querySelector('.hero-nav__current');
    const total = document.querySelector('.hero-nav__total');
    if (total) total.textContent = '0' + el.querySelectorAll('.swiper-slide').length;

    new Swiper('.hero-swiper', {
      modules: [Navigation, Autoplay, EffectFade],
      effect: 'fade',
      fadeEffect: { crossFade: true },
      loop: true,
      speed: 800,
      autoplay: { delay: 5000, disableOnInteraction: false },
      navigation: {
        nextEl: '.hero-nav__next',
        prevEl: '.hero-nav__prev',
      },
      on: {
        slideChange(swiper) {
          if (counter) counter.textContent = '0' + ((swiper.realIndex % el.querySelectorAll('.swiper-slide').length) + 1);
        },
      },
    });
  }

  initHeroSwiper();
  document.addEventListener('astro:page-load', initHeroSwiper);
</script>

<style>
  .hero-swiper-section { position: relative; height: 100vh; width: 100%; overflow: hidden; }
  .hero-swiper { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-swiper :global(.swiper-wrapper) { transition-timing-function: ease-in-out; }
  .hero-slide { position: relative; width: 100%; height: 100vh; }
  .hero-slide__img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.15) contrast(1.05); }
  .hero-slide__overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(28,41,95,.85) 0%, rgba(28,59,135,.55) 50%, rgba(28,59,135,.3) 100%);
  }
  .hero-content {
    position: absolute; inset: 0; z-index: 10;
    display: flex; align-items: center;
  }
  .hero-corner {
    position: absolute; bottom: 2rem; left: 0; right: 0; z-index: 10;
  }
  .hero-nav {
    position: absolute; bottom: 2rem; right: 2rem; z-index: 10;
    display: flex; align-items: center; gap: 1rem;
  }
  .hero-nav__btn {
    width: 48px; height: 48px;
    border: 1.5px solid rgba(250,246,235,.4);
    background: transparent; color: var(--color-bg-offwhite);
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; transition: all .3s;
  }
  .hero-nav__btn:hover { background: var(--color-bg-offwhite); color: var(--color-primary-blue); }
  .hero-nav__counter {
    font-family: var(--font-display); font-weight: 600;
    font-size: 0.85rem; letter-spacing: 0.1em;
    color: var(--color-bg-offwhite); display: flex; align-items: baseline; gap: 0.25rem;
  }
  .hero-nav__current { font-size: 1.4rem; color: var(--color-accent-yellow); }
  .hero-nav__sep { opacity: 0.4; }
  .hero-nav__total { opacity: 0.5; }
  @media (prefers-reduced-motion: reduce) {
    .hero-swiper :global(.swiper-wrapper) { transition-duration: 0.001s !important; }
  }
</style>
