---
---

<section class="relative bg-[var(--color-bg-offwhite)] pt-28 pb-16 lg:pt-36 lg:pb-24">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Text -->
      <div class="lg:col-span-6">
        <div class="flex items-center gap-3 mb-7">
          <div class="w-8 h-[2px] bg-[var(--color-burgundy)]"></div>
          <span class="font-display font-500 text-[0.7rem] tracking-[0.28em] uppercase text-[var(--color-burgundy)]">Est. 1987 · Fakultas Hukum UI</span>
        </div>
        <h1 class="text-[2.8rem] sm:text-[3.6rem] lg:text-[4.8rem] leading-[0.96] mb-7 text-[var(--color-primary-blue)]">
          <span class="drop-cap">M</span>embangun<br />
          Bakat Hukum<br />
          <span class="text-[var(--color-burgundy)]">Masa Depan</span>
        </h1>
        <p class="font-body text-[1.08rem] lg:text-[1.15rem] text-[var(--color-ink)] leading-relaxed mb-10 max-w-[560px]">
          Law Student Association for Legal Practice — wadah pengembangan kompetensi praktis hukum bagi mahasiswa Fakultas Hukum Universitas Indonesia.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/programs" class="btn-primary">Jelajahi Program <span>→</span></a>
          <a href="/about" class="btn-outline">Tentang LaSALe</a>
        </div>

        <!-- Corner mark -->
        <div class="mt-12 flex items-center gap-3">
          <div class="w-10 h-[1px] bg-[var(--color-primary-blue)]/20"></div>
          <span class="font-body text-[0.65rem] tracking-[0.3em] uppercase text-[var(--color-ink)]/40">Scroll to Explore</span>
        </div>
      </div>

      <!-- Image block -->
      <div class="lg:col-span-6 relative">
        <div class="relative">
          <!-- Decorative accents -->
          <div class="absolute -left-4 -top-4 w-20 h-20 bg-[var(--color-accent-yellow)] z-0 hidden lg:block"></div>
          <div class="absolute -right-3 -bottom-3 w-28 h-28 border-2 border-[var(--color-accent-yellow)] z-0 hidden lg:block"></div>

          <!-- Main image -->
          <div class="relative img-tint border-2 border-[var(--color-primary-blue)] z-10">
            <img src="https://picsum.photos/seed/lasale-hero/1100/720.jpg" alt="LaSALe FH UI" class="w-full h-[380px] lg:h-[480px] object-cover duotone-img" />
            <div class="img-badge img-badge--yellow">LaSALe FH UI · Est. 1987</div>
          </div>

          <!-- Floating stat -->
          <div class="absolute -bottom-6 left-6 lg:left-10 bg-[var(--color-bg-offwhite)] p-5 border-2 border-[var(--color-primary-blue)] z-20">
            <div class="font-script text-[var(--color-burgundy)] text-xl leading-none mb-1">No.</div>
            <div class="font-display font-700 text-[var(--color-primary-blue)] text-3xl leading-none mb-2">XXXVII</div>
            <div class="font-body text-[0.75rem] text-[var(--color-ink)]/60 leading-snug">Edisi ke-37</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
