---
export interface Props {
  class?: string;
  transparent?: boolean;
}
const { class: className = '', transparent = false } = Astro.props;
---

<style>
  .nav-hidden {
    transform: translateY(-100%);
    opacity: 0;
  }

  .nav-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .nav-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 36px;
    height: 36px;
    background: var(--color-primary);
    border: none;
    cursor: pointer;
    gap: 5px;
    padding: 0;
  }

  .nav-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--color-warm-white);
    transition: transform var(--duration-fast) var(--ease-out-expo);
  }

  .nav-toggle.open span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }

  .nav-toggle.open span:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle.open span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  @media (max-width: 1023px) {
    .nav-menu {
      position: fixed;
      top: 0;
      right: 0;
      width: 100%;
      height: 100dvh;
      background: var(--color-warm-white);
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: var(--space-8);
      transform: translateX(100%);
      transition: transform var(--duration-normal) var(--ease-in-out);
      z-index: 38;
    }

    .nav-menu.open {
      transform: translateX(0);
    }

    .nav-toggle {
      display: flex;
    }
  }

  @media (min-width: 1024px) {
    .nav-toggle {
      display: none;
    }
  }
</style>

<header
  id="site-nav"
  class:list={[className]}
  style={{
    position: 'fixed',
    top: 0,
    left: 0,
    right: 0,
    zIndex: 'var(--z-nav)',
    transition: 'transform 0.5s var(--ease-in-out), opacity 0.5s var(--ease-in-out), background 0.3s',
    background: transparent ? 'transparent' : 'var(--color-warm-white)',
    borderBottom: transparent ? 'none' : '1px solid rgba(40, 62, 156, 0.1)',
  }}
>
  <div style={{
    maxWidth: 'var(--max-w-content)',
    margin: '0 auto',
    padding: 'var(--space-5) var(--section-px)',
    display: 'flex',
    alignItems: 'center',
    justifyContent: 'space-between',
  }}>
    <a href="/" style={{ display: 'flex', alignItems: 'center', gap: 'var(--space-3)', textDecoration: 'none' }}>
      <div style={{ width: 36, height: 36, background: 'var(--color-primary)', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>
        <span style={{ fontFamily: 'var(--font-heading)', fontWeight: 700, color: 'var(--color-gold)', fontSize: '1.15rem', lineHeight: 1 }}>L</span>
      </div>
      <div style={{ lineHeight: 1.2 }}>
        <div style={{ fontFamily: 'var(--font-heading)', fontWeight: 600, color: 'var(--color-primary)', fontSize: '1.05rem', letterSpacing: '-0.01em' }}>LaSALe</div>
        <div style={{ fontFamily: 'var(--font-sans)', fontSize: '0.6rem', letterSpacing: '0.22em', textTransform: 'uppercase', color: 'var(--color-rose)' }}>Legal Practice Association</div>
      </div>
    </a>

    <nav id="nav-menu" class="nav-menu" style={{
      display: 'flex',
      alignItems: 'center',
      gap: 'var(--space-10)',
    }}>
      <a href="/" class="nav-link" style={{ fontFamily: 'var(--font-heading)', fontWeight: 500, fontSize: 'var(--text-xs)', letterSpacing: 'var(--tracking-wide)', textTransform: 'uppercase', color: 'var(--color-near-black)', textDecoration: 'none', position: 'relative', paddingBottom: '4px' }}>
        Home
        <span style={{ content: '', position: 'absolute', left: 0, right: 0, bottom: 0, height: '1.5px', background: 'var(--color-rose)', transform: 'scaleX(0)', transformOrigin: 'left', transition: 'transform var(--duration-normal)', display: 'block' }}></span>
      </a>
      <a href="/about" class="nav-link">About</a>
      <a href="/programs" class="nav-link">Programs</a>
      <a href="/insights" class="nav-link">Insights</a>
      <a href="/contact" class="nav-link">Contact</a>
    </nav>

    <div style={{ display: 'flex', alignItems: 'center', gap: 'var(--space-3)' }}>
      <a
        href="/contact"
        style={{
          display: 'inline-flex',
          alignItems: 'center',
          gap: '0.5rem',
          padding: '0.75rem 1.4rem',
          background: 'var(--color-primary)',
          color: '#fff',
          fontFamily: 'var(--font-heading)',
          fontWeight: 600,
          fontSize: 'var(--text-xs)',
          letterSpacing: 'var(--tracking-wide)',
          textTransform: 'uppercase',
          position: 'relative',
          border: 'none',
          cursor: 'pointer',
          textDecoration: 'none',
          transition: 'transform 0.35s var(--ease-out-expo)',
        }}
        class="btn-primary"
      >
        Join LaSALe
      </a>
      <button id="nav-toggle" class="nav-toggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('site-nav');
  const menu = document.getElementById('nav-menu');
  const toggle = document.getElementById('nav-toggle');
  const links = menu?.querySelectorAll('a');

  // Show/hide on scroll
  let lastScroll = 0;
  let isHidden = false;

  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;

    if (currentScroll > lastScroll && currentScroll > 100) {
      nav.classList.add('nav-hidden');
      nav.classList.remove('nav-visible');
      isHidden = true;
    } else if (currentScroll < lastScroll || currentScroll < 100) {
      nav.classList.remove('nav-hidden');
      nav.classList.add('nav-visible');
      isHidden = false;
    }

    lastScroll = currentScroll;

    // Add background when scrolled
    if (currentScroll > 50) {
      nav.style.background = 'var(--color-warm-white)';
      nav.style.borderBottom = '1px solid rgba(40, 62, 156, 0.1)';
    } else {
      nav.style.background = 'transparent';
      nav.style.borderBottom = 'none';
    }
  });

  // Mobile menu toggle
  if (toggle && menu) {
    const isMobile = () => window.innerWidth < 1024;

    toggle.addEventListener('click', () => {
      menu.classList.toggle('open');
      toggle.classList.toggle('open');
      document.body.style.overflow = menu.classList.contains('open') ? 'hidden' : '';
    });

    links?.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.remove('open');
        toggle.classList.remove('open');
        document.body.style.overflow = '';
      });
    });

    window.addEventListener('resize', () => {
      if (!isMobile() && menu.classList.contains('open')) {
        menu.classList.remove('open');
        toggle.classList.remove('open');
        document.body.style.overflow = '';
      }
    });
  }

  // Nav link hover effect
  links?.forEach(link => {
    const underline = link.querySelector('span');
    link.addEventListener('mouseenter', () => {
      if (underline) underline.style.transform = 'scaleX(1)';
    });
    link.addEventListener('mouseleave', () => {
      if (underline) underline.style.transform = 'scaleX(0)';
    });
  });
</script>
