---
export interface Props {
  class?: string;
  href?: string;
  variant?: 'primary' | 'rose' | 'outline' | 'text';
  children?: any;
}

const { class: className = '', href, variant = 'primary' } = Astro.props;

const styles: Record<string, string> = {
  primary: `
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.9rem;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    position: relative;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: transform .35s var(--ease-out-expo), box-shadow .35s;
  `,
  rose: `
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.9rem;
    background: var(--color-rose);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: transform .35s, box-shadow .35s;
  `,
  outline: `
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.9rem;
    background: transparent;
    color: var(--color-primary);
    border: 1.5px solid var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    transition: all .3s;
  `,
  text: `
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-rose);
    border-bottom: 2px solid var(--color-rose);
    padding-bottom: 0.25rem;
    text-decoration: none;
    transition: gap .25s var(--ease-out-expo);
  `,
};
---

{
  href ? (
    <a href={href} class:list={[className]} style={styles[variant]}>
      <slot />
    </a>
  ) : (
    <button class:list={[className]} style={styles[variant]}>
      <slot />
    </button>
  )
}

<style>
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -18px rgba(40, 62, 156, 0.55);
  }

  .btn-rose:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -18px rgba(177, 94, 103, 0.6);
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-text:hover {
    gap: 0.75rem;
  }
</style>
