---
const ABOUT_IMG = 'https://sqejhkhqqofigcnnmrjq.supabase.co/storage/v1/object/public/lasale-assets/fungsionaris/foto-bersama-pi-bph.jpg';
---

<section class="relative bg-[var(--color-primary-blue)] text-[var(--color-bg-offwhite)] overflow-hidden min-h-screen flex flex-col justify-center">
  <!-- Soft stars -->
  <div class="soft-star soft-star--yellow" style="width:420px;height:420px;top:10%;right:-5%;opacity:.13"></div>
  <div class="soft-star soft-star--burgundy" style="width:280px;height:280px;bottom:5%;left:30%;opacity:.18"></div>

  <!-- Portal sparkles -->
  <div class="portal" style="top:18%;left:8%">
    <svg width="16" height="16" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F6EB3D" opacity="0.9"/></svg>
  </div>
  <div class="portal" style="bottom:24%;right:42%">
    <svg width="10" height="10" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F7F2B7" opacity="0.7"/></svg>
  </div>

  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-20 lg:py-24 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      <!-- Text on top -->
      <div class="lg:col-span-5 lg:sticky lg:top-10">
        <div class="flex items-center gap-3 mb-7">
          <div class="w-8 h-[2px] bg-[var(--color-accent-yellow)]"></div>
          <span class="font-display font-500 text-[0.7rem] tracking-[0.28em] uppercase text-[var(--color-accent-yellow)]">Section II · Tentang</span>
        </div>
        <h2 class="text-[2.4rem] lg:text-[3.2rem] leading-[1.02] mb-7 text-[var(--color-bg-offwhite)]">
          <span class="drop-cap drop-cap-light">T</span>entang Kami
        </h2>
        <p class="font-body text-[1.02rem] text-[var(--color-bg-offwhite)]/80 leading-relaxed mb-6">
          Sejak 1987, LaSALe menjadi wadah pengembangan kompetensi praktis hukum bagi mahasiswa Fakultas Hukum Universitas Indonesia. Organisasi ini menghubungkan dunia pendidikan hukum dengan praktek profesional melalui program-program unggulan.
        </p>
        <p class="font-body text-[0.95rem] text-[var(--color-bg-offwhite)]/75 leading-relaxed mb-10">
          Anggota LaSALe mendapatkan akses ke rangkaian workshop, partisipasi amicus, dan bimbingan kasus — yang mengarah ke Sertifikat Praktik Lanjutan yang diakui oleh mitra-mitra profesional.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/about" class="btn-burgundy">Baca Selengkapnya</a>
          <a href="/about" class="inline-flex items-center gap-2 font-display font-600 text-[0.8rem] tracking-[0.14em] uppercase text-[var(--color-bg-offwhite)] border-b-2 border-[var(--color-accent-yellow)] pb-1">Kepengurusan 2026 <span>→</span></a>
        </div>
      </div>

      <!-- Image block -->
      <div class="lg:col-span-7 relative">
        <div class="relative">
          <!-- Layered decorative accents -->
          <div class="absolute -left-4 -top-4 w-24 h-24 bg-[var(--color-accent-yellow)] z-0 hidden lg:block"></div>
          <div class="absolute -right-3 -bottom-3 w-32 h-32 border-2 border-[var(--color-accent-yellow)] z-0 hidden lg:block"></div>

          <!-- Main image -->
          <div class="relative img-tint img-tint--heavy border-2 border-[var(--color-accent-yellow)]/40 z-10">
            <img src={ABOUT_IMG} alt="" class="w-full h-[460px] lg:h-[580px] object-cover duotone-img" loading="lazy" />
            <div class="img-badge img-badge--yellow">LaSALe FH UI · Est. 1987</div>
          </div>

          <!-- Floating caption block -->
          <div class="absolute -bottom-8 left-6 lg:left-12 bg-[var(--color-bg-offwhite)] p-5 lg:p-6 max-w-[320px] z-20 border-2 border-[var(--color-primary-blue)]">
            <div class="font-script text-[var(--color-burgundy)] text-2xl leading-none mb-1">No.</div>
            <div class="font-display font-700 text-[var(--color-primary-blue)] text-3xl leading-none mb-3">XXXVII</div>
            <div class="font-body text-[0.85rem] text-[var(--color-ink)]/80 leading-snug">Edisi ke-37 LaSALe — program-program unggulan yang terus berkembang setiap tahun.</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Wave transition to light -->
  <div class="wave-svg absolute bottom-0 left-0 right-0 z-0">
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none" class="w-full h-[60px]">
      <path d="M0,40 C240,80 480,0 720,30 C960,60 1200,10 1440,40 L1440,80 L0,80 Z" fill="#FAF6EB"/>
    </svg>
  </div>
</section>
