---
---

<footer class="relative bg-[var(--color-ink)] text-[var(--color-bg-offwhite)] overflow-hidden">
  <!-- Top accent line -->
  <div class="h-[3px] bg-gradient-to-r from-[var(--color-primary-blue)] via-[var(--color-burgundy)] to-[var(--color-accent-yellow)]"></div>

  <div class="soft-star soft-star--yellow" style="width:340px;height:340px;top:10%;right:-5%;opacity:.08"></div>
  <div class="soft-star soft-star--burgundy" style="width:280px;height:280px;bottom:5%;left:0;opacity:.12"></div>
  <div class="portal" style="top:18%;left:8%">
    <svg width="14" height="14" viewBox="0 0 24 24"><path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill="#F6EB3D" opacity="0.8"/></svg>
  </div>

  <!-- Newsletter band -->
  <div class="border-b border-[var(--color-bg-offwhite)]/12">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 lg:py-20">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <div class="lg:col-span-6">
          <div class="font-display font-500 text-[0.7rem] tracking-[0.28em] uppercase text-[var(--color-accent-yellow)] mb-4">LaSALe Quarterly</div>
          <h3 class="text-[2rem] lg:text-[2.6rem] text-[var(--color-bg-offwhite)] leading-[1.05] mb-3">Dispatches from the Practice.</h3>
          <p class="font-body text-[0.98rem] text-[var(--color-bg-offwhite)]/65 max-w-xl leading-relaxed">Empat kali setahun, kami menerbitkan ringkasan untuk anggota — opini terbaru, catatan drafting, deadline fellow, dan catatan konferensi.</p>
        </div>
        <div class="lg:col-span-6">
          <form class="flex flex-col sm:flex-row gap-0 border-2 border-[var(--color-bg-offwhite)]/30 focus-within:border-[var(--color-accent-yellow)] transition-colors">
            <input type="email" placeholder="member@law.edu" class="sharp-input flex-1" required />
            <button type="submit" class="bg-[var(--color-accent-yellow)] text-[var(--color-primary-blue)] font-display font-700 text-[0.78rem] tracking-[0.16em] uppercase px-8 py-4 hover:bg-[var(--color-pale-cream)] transition-colors">Subscribe →</button>
          </form>
          <div class="font-body text-[0.72rem] text-[var(--color-bg-offwhite)]/45 mt-3 tracking-wide">Kami menerbitkan empat edisi per tahun. Tidak ada komunikasi komersial.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main footer grid -->
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16 lg:py-20 relative z-10">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-8">
      <!-- Brand block -->
      <div class="lg:col-span-4">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-[var(--color-primary-blue)] flex items-center justify-center">
            <span class="font-display font-700 text-[var(--color-accent-yellow)] text-xl leading-none">L</span>
          </div>
          <div class="leading-tight">
            <div class="font-display font-600 text-[var(--color-bg-offwhite)] text-[1.1rem]">LaSALe</div>
            <div class="font-body text-[0.62rem] tracking-[0.22em] uppercase text-[var(--color-accent-yellow)]">Legal Practice Association</div>
          </div>
        </div>
        <p class="font-body text-[0.92rem] text-[var(--color-bg-offwhite)]/60 leading-relaxed mb-6 max-w-sm">
          Law Student Association for Legal Practice. Didirikan 1987. Bagian dari BEM Fakultas Hukum Universitas Indonesia.
        </p>
        <div class="font-body text-[0.85rem] text-[var(--color-bg-offwhite)]/70 leading-relaxed">
          <div>Fakultas Hukum Universitas Indonesia</div>
          <div>Kampus Baru UI, Depok</div>
          <div class="mt-2 text-[var(--color-accent-yellow)]">info@lasale.ac.id</div>
        </div>
      </div>

      <!-- Navigation matrices -->
      <div class="lg:col-span-2">
        <div class="font-display font-600 text-[0.7rem] tracking-[0.22em] uppercase text-[var(--color-accent-yellow)] mb-5">Program</div>
        <ul class="space-y-3 font-body text-[0.92rem]">
          <li><a href="/programs" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Konsultasi Hukum</a></li>
          <li><a href="/programs" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Simulasi Sidang</a></li>
          <li><a href="/programs" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">LITASI</a></li>
          <li><a href="/programs" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">KTBBH</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <div class="font-display font-600 text-[0.7rem] tracking-[0.22em] uppercase text-[var(--color-accent-yellow)] mb-5">Artikel</div>
        <ul class="space-y-3 font-body text-[0.92rem]">
          <li><a href="/lasale" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">LaSALe Page</a></li>
          <li><a href="/lasale" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Analisis Hukum</a></li>
          <li><a href="/lasale" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Opini</a></li>
          <li><a href="/lasale" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Berita</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <div class="font-display font-600 text-[0.7rem] tracking-[0.22em] uppercase text-[var(--color-accent-yellow)] mb-5">Tentang</div>
        <ul class="space-y-3 font-body text-[0.92rem]">
          <li><a href="/about" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Sejarah</a></li>
          <li><a href="/about" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Visi & Misi</a></li>
          <li><a href="/events" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Events</a></li>
          <li><a href="/contact" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Kontak</a></li>
        </ul>
      </div>

      <div class="lg:col-span-2">
        <div class="font-display font-600 text-[0.7rem] tracking-[0.22em] uppercase text-[var(--color-accent-yellow)] mb-5">Connect</div>
        <ul class="space-y-3 font-body text-[0.92rem]">
          <li><a href="https://www.instagram.com/lasalefhui/" target="_blank" rel="noopener" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Instagram</a></li>
          <li><a href="https://www.linkedin.com/company/lasale-fh-ui/" target="_blank" rel="noopener" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">LinkedIn</a></li>
          <li><a href="/contact" class="text-[var(--color-bg-offwhite)]/70 hover:text-[var(--color-bg-offwhite)] transition">Email</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-[var(--color-bg-offwhite)]/12">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-6 flex flex-wrap items-center justify-between gap-3">
      <div class="font-body text-[0.72rem] tracking-[0.18em] uppercase text-[var(--color-bg-offwhite)]/45">
        © {new Date().getFullYear()} LaSALe FH UI
      </div>
      <div class="flex items-center gap-6 font-body text-[0.72rem] tracking-[0.18em] uppercase text-[var(--color-bg-offwhite)]/45">
        <a href="#" class="hover:text-[var(--color-accent-yellow)] transition">Privacy</a>
        <a href="#" class="hover:text-[var(--color-accent-yellow)] transition">Terms</a>
      </div>
      <div class="font-body text-[0.7rem] tracking-[0.2em] uppercase text-[var(--color-bg-offwhite)]/35 flex items-center gap-2">
        <span class="font-script text-[var(--color-accent-yellow)] text-base leading-none">No.</span>
        <span>XXXVII</span>
      </div>
    </div>
  </div>
</footer>
