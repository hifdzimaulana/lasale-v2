---
const benefits = [
  { num: '01', title: 'Konsultasi Hukum', desc: 'Layanan konsultasi hukum gratis untuk masyarakat.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><rect x="5" y="8" width="30" height="24" stroke="#1C3B87" stroke-width="2"/><path d="M5 8 L20 20 L35 8" stroke="#994B53" stroke-width="2"/><circle cx="20" cy="20" r="2" fill="#F6EB3D"/></svg>` },
  { num: '02', title: 'Simulasi Sidang', desc: 'Latihan litigasi dalam suasana persidangan nyata.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><path d="M20 4 L34 12 L34 28 L20 36 L6 28 L6 12 Z" stroke="#1C3B87" stroke-width="2"/><path d="M14 20 L18 24 L26 16" stroke="#994B53" stroke-width="2"/></svg>` },
  { num: '03', title: 'LITASI', desc: 'Literasi hukum untuk pemahaman masyarakat.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><rect x="6" y="10" width="28" height="22" stroke="#1C3B87" stroke-width="2"/><path d="M6 16 L34 16" stroke="#994B53" stroke-width="2"/><circle cx="11" cy="13" r="1" fill="#994B53"/><circle cx="15" cy="13" r="1" fill="#994B53"/></svg>` },
  { num: '04', title: 'KTBBH', desc: 'Kursus Tanggap Bahasa untuk Berbagi Hukum.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="14" stroke="#1C3B87" stroke-width="2"/><path d="M14 20 L18 24 L26 16" stroke="#994B53" stroke-width="2"/></svg>` },
  { num: '05', title: 'Jaringan Alumni', desc: 'Akses seumur hidup ke ribuan alumni LaSALe.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><path d="M8 8 L32 8 L32 32 L8 32 Z" stroke="#1C3B87" stroke-width="2"/><path d="M14 14 L26 14 M14 20 L26 20 M14 26 L22 26" stroke="#994B53" stroke-width="2"/></svg>` },
  { num: '06', title: 'Workshop', desc: 'Workshop penulisan hukum dan advokasi.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><circle cx="14" cy="16" r="5" stroke="#1C3B87" stroke-width="2"/><circle cx="26" cy="16" r="5" stroke="#994B53" stroke-width="2"/><path d="M6 32 C6 26 10 24 14 24 C18 24 22 26 22 32" stroke="#1C3B87" stroke-width="2"/><path d="M18 32 C18 26 22 24 26 24 C30 24 34 26 34 32" stroke="#994B53" stroke-width="2"/></svg>` },
  { num: '07', title: 'Simposium', desc: 'Registrasi gratis ke simposium tahunan.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><path d="M20 4 L36 12 L36 28 L20 36 L4 28 L4 12 Z" stroke="#1C3B87" stroke-width="2"/><path d="M20 4 L20 36 M4 12 L36 12 M4 28 L36 28" stroke="#994B53" stroke-width="1.5"/></svg>` },
  { num: '08', title: 'Karir', desc: 'Prioritas rekrutmen dari mitra profesional.', icon: `<svg width="38" height="38" viewBox="0 0 40 40" fill="none"><rect x="6" y="12" width="28" height="20" stroke="#1C3B87" stroke-width="2"/><path d="M12 12 L12 8 L28 8 L28 12" stroke="#994B53" stroke-width="2"/><path d="M6 22 L34 22" stroke="#994B53" stroke-width="2"/></svg>` },
];
---

<section class="relative bg-[var(--color-bg-offwhite)] grid-bg pt-24 lg:pt-32 pb-24 lg:pb-32">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="grid lg:grid-cols-12 gap-8 mb-16">
      <div class="lg:col-span-6">
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-[2px] bg-[var(--color-burgundy)]"></div>
          <span class="font-display font-500 text-[0.7rem] tracking-[0.28em] uppercase text-[var(--color-burgundy)]">Section III · Keanggotaan</span>
        </div>
        <h2 class="text-[2.2rem] lg:text-[2.8rem] leading-[1.04]">
          <span class="drop-cap">H</span>ak & Manfaat Keanggotaan
        </h2>
      </div>
      <div class="lg:col-span-5 lg:col-start-8 flex items-end">
        <p class="font-body text-[1rem] text-[var(--color-ink)]/70 leading-relaxed">
          Delapan manfaat mendasar membentuk setiap keanggotaan LaSALe. Dirancang untuk menambah nilai sepanjang masa studi hukum dan meluas ke tahun-tahun pertama praktek.
        </p>
      </div>
    </div>

    <!-- Icon grid -->
    <div class="grid grid-cols-2 lg:grid-cols-4 border-t-2 border-l-2 border-[var(--color-primary-blue)]">
      {benefits.map((b) => (
        <div class="p-8 lg:p-10 border-r-2 border-b-2 border-[var(--color-primary-blue)] hover:bg-[var(--color-pale-cream)] transition-colors duration-300 group">
          <Fragment set:html={b.icon} />
          <div class="font-display font-600 text-[0.65rem] tracking-[0.22em] uppercase text-[var(--color-burgundy)] mb-2 mt-6">{b.num}</div>
          <h4 class="text-[1.1rem] mb-2">{b.title}</h4>
          <p class="font-body text-[0.88rem] text-[var(--color-ink)]/65 leading-relaxed">{b.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
