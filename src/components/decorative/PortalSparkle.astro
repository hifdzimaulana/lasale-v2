---
export interface Props {
  class?: string;
  color?: string;
  size?: number;
  opacity?: string;
  top?: string;
  right?: string;
  bottom?: string;
  left?: string;
  depth?: number;
}

const { class: className = '', color = '#FFF34A', size = 18, opacity = '0.85', top = 'auto', right = 'auto', bottom = 'auto', left = 'auto' } = Astro.props;
---

<div
  class:list={['portal', className]}
  style={{
    position: 'absolute',
    top,
    right,
    bottom,
    left,
    pointerEvents: 'none',
    zIndex: 1,
    opacity,
  }}
>
  <svg width={size} height={size} viewBox="0 0 24 24" style={{ display: 'block' }}>
    <path d="M12 0 L13 11 L24 12 L13 13 L12 24 L11 13 L0 12 L11 11 Z" fill={color} />
  </svg>
</div>
