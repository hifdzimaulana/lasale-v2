---
export interface Props {
  color?: 'gold' | 'blue' | 'cream' | 'rose';
  size?: string;
  top?: string;
  right?: string;
  bottom?: string;
  left?: string;
  opacity?: string;
}

const colorMap: Record<string, string> = {
  gold: 'var(--color-gold)',
  blue: 'var(--color-primary)',
  cream: 'var(--color-cream)',
  rose: 'var(--color-rose)',
};

const { color = 'gold', size = '300px', top = 'auto', right = 'auto', bottom = 'auto', left = 'auto', opacity = '0.12' } = Astro.props;
---

<div
  class="soft-star"
  style={{
    position: 'absolute',
    width: size,
    height: size,
    top,
    right,
    bottom,
    left,
    borderRadius: '50%',
    filter: 'blur(60px)',
    opacity,
    pointerEvents: 'none',
    zIndex: 0,
    background: colorMap[color],
  }}
></div>
