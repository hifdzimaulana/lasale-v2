---
export interface Props {
  class?: string;
  as?: 'div' | 'section' | 'article' | 'header' | 'footer';
  narrow?: boolean;
}

const { class: className = '', as: Tag = 'div' } = Astro.props;
const maxW = 'var(--max-w-content)';
---

<Tag class:list={[className]} style={{ maxWidth: maxW, marginLeft: 'auto', marginRight: 'auto', paddingLeft: 'var(--section-px)', paddingRight: 'var(--section-px)' }}>
  <slot />
</Tag>
