---
const programs = [
  {
    num: '01',
    title: 'Konsultasi Hukum',
    description: 'Layanan konsultasi hukum gratis untuk masyarakat umum yang membutuhkan bantuan hukum, dibimbing oleh dosen pembimbing.',
    img: 'https://picsum.photos/seed/prog-konsul/500/600.jpg',
  },
  {
    num: '02',
    title: 'Simulasi Sidang',
    description: 'Simulasi persidangan untuk melatih kemampuan litigasi dan argumentasi hukum mahasiswa dalam suasana sidang yang nyata.',
    img: 'https://picsum.photos/seed/prog-simulasi/500/600.jpg',
  },
  {
    num: '03',
    title: 'LITASI',
    description: 'Program literasi hukum untuk meningkatkan pemahaman masyarakat tentang hak dan kewajiban hukum melalui seminar dan workshop.',
    img: 'https://picsum.photos/seed/prog-litasi/500/600.jpg',
  },
  {
    num: '04',
    title: 'KTBBH',
    description: 'Kuliah Terselia Bhakti Bakti Hukum — program pengabdian kepada masyarakat dalam bentuk penyuluhan dan bantuan hukum.',
    img: 'https://picsum.photos/seed/prog-ktbbh/500/600.jpg',
  },
  {
    num: '05',
    title: 'Seminar Hukum',
    description: 'Seminar dan diskusi panel dengan pakar hukum ternama membahas isu-isu terkini di dunia praktik hukum Indonesia.',
    img: 'https://picsum.photos/seed/prog-seminar/500/600.jpg',
  },
  {
    num: '06',
    title: 'Workshop Legal Writing',
    description: 'Pelatihan menulis artikel hukum dan legal research untuk mahasiswa yang ingin mengembangkan kemampuan akademis.',
    img: 'https://picsum.photos/seed/prog-workshop/500/600.jpg',
  },
];
---

<section class="relative bg-[var(--color-bg-offwhite)] py-20 lg:py-28">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 mb-10">
    <div class="flex items-center gap-3">
      <div class="w-8 h-[2px] bg-[var(--color-primary-blue)]"></div>
      <span class="font-display font-500 text-[0.7rem] tracking-[0.28em] uppercase text-[var(--color-primary-blue)]">Section III · Program</span>
    </div>
    <h2 class="text-[2.2rem] lg:text-[2.8rem] leading-[1.04] mt-5">
      <span class="drop-cap">P</span>rogram Kami
    </h2>
  </div>

  <!-- Scrollable cards -->
  <div class="program-scroll overflow-x-auto no-scrollbar pb-4">
    <div class="program-scroll__track flex gap-5 px-6 lg:px-10 w-max">
      {programs.map((p) => (
        <article class="program-card relative w-[300px] lg:w-[360px] flex-shrink-0 border-2 border-[var(--color-primary-blue)] overflow-hidden group cursor-pointer">
          <!-- Image background -->
          <div class="absolute inset-0">
            <img src={p.img} alt={p.title} class="w-full h-full object-cover duotone-img transition-transform duration-700 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-primary-blue)] via-[var(--color-primary-blue)]/70 to-[var(--color-primary-blue)]/20"></div>
          </div>
          <!-- Content -->
          <div class="relative z-10 p-8 h-full flex flex-col justify-end min-h-[400px]">
            <div class="font-display font-700 text-[var(--color-accent-yellow)] text-5xl leading-none mb-4 opacity-60">{p.num}</div>
            <h3 class="font-display font-600 text-[1.4rem] text-[var(--color-bg-offwhite)] leading-tight mb-3">{p.title}</h3>
            <p class="font-body text-[0.9rem] text-[var(--color-bg-offwhite)]/70 leading-relaxed mb-5">{p.description}</p>
            <span class="font-display font-600 text-[0.72rem] tracking-[0.16em] uppercase text-[var(--color-accent-yellow)] inline-flex items-center gap-2">
              Selengkapnya <span>→</span>
            </span>
          </div>
          <!-- Top edge accent -->
          <div class="absolute top-0 left-0 right-0 h-[4px] bg-gradient-to-r from-[var(--color-accent-yellow)] to-[var(--color-burgundy)] z-20"></div>
        </article>
      ))}
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 mt-6 flex items-center gap-3">
    <div class="w-10 h-[1px] bg-[var(--color-primary-blue)]/20"></div>
    <span class="font-body text-[0.65rem] tracking-[0.3em] uppercase text-[var(--color-ink)]/40">Geser untuk melihat semua →</span>
  </div>
</section>

<style>
  .program-scroll { -webkit-overflow-scrolling: touch; }
  .program-scroll::-webkit-scrollbar { height: 0; }
</style>
