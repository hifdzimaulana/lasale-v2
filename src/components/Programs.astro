---
const programs = [
  {
    title: 'Konsultasi Hukum',
    description: 'Layanan konsultasi hukum gratis untuk masyarakat umum yang membutuhkan bantuan hukum.',
    icon: '⚖️',
    color: 'bg-primary-blue',
  },
  {
    title: 'LITASI',
    description: 'Program literasi hukum untuk meningkatkan pemahaman masyarakat tentang hak dan kewajiban hukum.',
    icon: '📚',
    color: 'bg-burgundy',
  },
  {
    title: 'Simulasi Sidang',
    description: 'Simulasi persidangan untuk melatih kemampuan litigasi dan argumentasi hukum mahasiswa.',
    icon: '🏛️',
    color: 'bg-primary-blue',
  },
  {
    title: 'KTBBH',
    description: 'Kursus Tanggap Bahasa untuk Berbagi Hukum — membangun kemampuan komunikasi hukum.',
    icon: '💬',
    color: 'bg-burgundy',
  },
];
---

<section class="relative py-24 md:py-32 bg-bg-dark grid-bg">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <p class="font-utility text-xs tracking-[0.3em] uppercase text-gold mb-4">Program Unggulan</p>
      <h2 class="font-heading text-4xl md:text-5xl font-semibold text-pale-cream">
        Program <span class="text-gradient-gold">LaSALe</span>
      </h2>
    </div>

    <!-- Programs Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {programs.map((program) => (
        <div class="group relative border border-pale-cream/10 p-8 hover:border-gold/30 transition-colors duration-300">
          <div class={`inline-flex items-center justify-center w-12 h-12 ${program.color} text-pale-cream text-xl mb-4`}>
            {program.icon}
          </div>
          <h3 class="font-heading text-xl font-semibold text-pale-cream mb-3 group-hover:text-gold transition-colors">
            {program.title}
          </h3>
          <p class="font-body text-sm text-pale-cream/60 leading-relaxed">
            {program.description}
          </p>
          <div class="absolute top-0 right-0 w-0 h-0 border-t-[40px] border-t-gold/10 border-l-[40px] border-l-transparent group-hover:border-t-gold/30 transition-colors duration-300"></div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a href="/programs" class="btn btn-outline">
        Lihat Semua Program
      </a>
    </div>
  </div>
</section>
