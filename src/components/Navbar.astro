---

<header class="absolute top-0 left-0 right-0 z-40">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-6 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <div class="w-9 h-9 bg-[var(--color-primary-blue)] flex items-center justify-center">
        <span class="font-display font-700 text-[var(--color-accent-yellow)] text-lg leading-none">L</span>
      </div>
      <div class="leading-tight">
        <div class="font-display font-600 text-[var(--color-primary-blue)] text-[1.05rem] tracking-tight">LaSALe</div>
        <div class="font-body text-[0.62rem] tracking-[0.22em] uppercase text-[var(--color-burgundy)]">Legal Practice Association</div>
      </div>
    </a>

    <nav class="hidden lg:flex items-center gap-9">
      <a href="/" class="nav-link">Home</a>
      <a href="/about" class="nav-link">About</a>
      <a href="/programs" class="nav-link">Programs</a>
      <a href="/lasale" class="nav-link">LaSALe</a>
      <a href="/events" class="nav-link">Events</a>
      <a href="/contact" class="nav-link">Contact</a>
    </nav>

    <div class="flex items-center gap-3">
      <a href="/contact" class="btn-outline hidden md:inline-flex">Contact Us</a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>
