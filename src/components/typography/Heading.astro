---
export interface Props {
  class?: string;
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'div' | 'span';
  size?: 'xs' | 'sm' | 'base' | 'lg' | 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl';
  color?: string;
  weight?: '500' | '600' | '700';
  tracking?: string;
  leading?: string;
}

const { class: className = '', as: Tag = 'h2', size = '2xl', color, weight = '600', tracking, leading } = Astro.props;

const sizeMap: Record<string, string> = {
  xs: 'var(--text-xs)',
  sm: 'var(--text-sm)',
  base: 'var(--text-base)',
  lg: 'var(--text-lg)',
  xl: 'var(--text-xl)',
  '2xl': 'var(--text-2xl)',
  '3xl': 'var(--text-3xl)',
  '4xl': 'var(--text-4xl)',
  '5xl': 'var(--text-5xl)',
  '6xl': 'var(--text-6xl)',
  '7xl': 'var(--text-7xl)',
};
---

<Tag
  class:list={[className]}
  style={{
    fontFamily: 'var(--font-heading)',
    fontWeight: weight,
    letterSpacing: tracking ?? '-0.015em',
    lineHeight: leading ?? 'var(--leading-tight)',
    fontSize: sizeMap[size],
    color: color ?? 'var(--color-primary)',
    margin: 0,
  }}
>
  <slot />
</Tag>
