---
const articles = [
  {
    title: 'Analisis Regulasi Kecerdasan Buatan di Indonesia',
    category: 'Analysis',
    date: '15 Agustus 2026',
    readTime: '8 min read',
    excerpt: 'Kajian mendalam tentang regulasi kecerdasan buatan yang sedang dikembangkan di Indonesia.',
    badge: 'img-badge--blue',
    badgeText: 'Analisis',
  },
  {
    title: 'Pentingnya Literasi Hukum bagi Masyarakat',
    category: 'Opinion',
    date: '10 Agustus 2026',
    readTime: '12 min read',
    excerpt: 'Perspektif tentang urgensi peningkatan literasi hukum di kalangan masyarakat luas.',
    badge: '',
    badgeText: 'Opini',
  },
  {
    title: 'LaSALe Gelar Simulasi Sidang Nasional',
    category: 'News',
    date: '05 Agustus 2026',
    readTime: '5 min read',
    excerpt: 'Liputan pelaksanaan simulasi sidang nasional yang diikuti mahasiswa hukum dari berbagai universitas.',
    badge: 'img-badge--yellow',
    badgeText: 'Berita',
  },
];
---

<section class="bg-[var(--color-bg-offwhite)] py-24 lg:py-32 grid-bg">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
    <div class="flex flex-wrap items-end justify-between mb-12 gap-6">
      <div>
        <div class="flex items-center gap-3 mb-5">
          <div class="w-8 h-[2px] bg-[var(--color-burgundy)]"></div>
          <span class="font-display font-500 text-[0.7rem] tracking-[0.28em] uppercase text-[var(--color-burgundy)]">Section VI · LaSALe Page</span>
        </div>
        <h2 class="text-[2.2rem] lg:text-[2.8rem] leading-[1.04]">
          <span class="drop-cap">A</span>rtikel Hukum
        </h2>
      </div>
      <a href="/lasale" class="btn-outline">Lihat Semua Artikel</a>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {articles.map((a) => (
        <article class="group">
          <div class="relative img-tint border-2 border-[var(--color-primary-blue)] mb-5 overflow-hidden">
            <img src={`https://picsum.photos/seed/lasale-news-${a.category}/600/420.jpg`} alt="" class="w-full h-[240px] lg:h-[280px] object-cover duotone-img transition-transform duration-700 group-hover:scale-105" />
            <div class:list={['img-badge', a.badge]}>{a.badgeText}</div>
          </div>
          <div class="flex items-center gap-3 mb-3">
            <div class="font-body text-[0.7rem] tracking-[0.2em] uppercase text-[var(--color-burgundy)]">{a.date}</div>
            <div class="w-1 h-1 bg-[var(--color-ink)]/30"></div>
            <div class="font-body text-[0.7rem] tracking-[0.2em] uppercase text-[var(--color-ink)]/50">{a.readTime}</div>
          </div>
          <h3 class="text-[1.4rem] mb-3 leading-tight group-hover:text-[var(--color-burgundy)] transition-colors">{a.title}</h3>
          <p class="font-body text-[0.92rem] text-[var(--color-ink)]/65 leading-relaxed mb-4">{a.excerpt}</p>
          <a href="/lasale" class="font-display font-600 text-[0.75rem] tracking-[0.16em] uppercase text-[var(--color-burgundy)] inline-flex items-center gap-2 border-b border-[var(--color-burgundy)] pb-1">Baca Artikel <span>→</span></a>
        </article>
      ))}
    </div>
  </div>
</section>
