---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'LaSALe — Law Student Association for Legal Practice',
  description = 'The Law Student Association for Legal Practice at the Faculty of Law, Universitas Indonesia. Established 1987.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:inline>
      *, *::before, *::after { border-radius: 0 !important; }
      html, body { margin: 0; padding: 0; }
      body {
        font-family: var(--font-body);
        background: var(--color-bg-offwhite);
        color: var(--color-ink);
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      h1, h2, h3, h4, h5 {
        font-family: var(--font-display);
        font-weight: 600;
        letter-spacing: -0.015em;
        line-height: 1.05;
        color: inherit;
      }
      .font-display { font-family: var(--font-display); }
      .font-script { font-family: var(--font-script); }
      .font-body { font-family: var(--font-body); }
      .drop-cap {
        font-family: "Pinyon Script", cursive !important;
        font-weight: 400;
        font-size: 2.8em;
        line-height: 0.7;
        color: var(--color-burgundy) !important;
        float: left;
        margin-right: 0.06em;
        margin-top: 0.05em;
        text-transform: none;
      }
      .drop-cap--gold,
      .drop-cap-light {
        color: var(--color-accent-yellow) !important;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
