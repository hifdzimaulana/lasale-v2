---
import '../designsystem/tokens.css';
import '../designsystem/base.css';
import '../designsystem/animations.css';
import '../designsystem/utilities.css';

export interface Props {
  title?: string;
}

const { title = 'LaSALe — Law Student Association for Legal Practice' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="The Law Student Association for Legal Practice unites the next generation of attorneys, scholars, and advocates." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600&family=Jost:wght@500;600;700&family=Pinyon+Script&display=swap" rel="stylesheet" />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>
